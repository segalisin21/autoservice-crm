{
  "name": "autoservice-crm",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node scripts/migrate.js && node scripts/seed-catalog.js && node scripts/seed-owner.js && node server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:railway-delta": "node scripts/migrate-railway-delta.js",
    "setup:db": "node scripts/setup-database.js",
    "build:migrate-full": "node scripts/build-postgres-full-migration.js && node scripts/build-sqlite-full-migration.js",
    "seed:owner": "node scripts/seed-owner.js",
    "seed:catalog": "node scripts/seed-catalog.js",
    "import:uchet": "node scripts/import-uchet-csv.js",
    "import:price": "node scripts/import-price.js",
    "import:price-sheet": "node scripts/import-price-sheet.js",
    "sync:vehicles": "node scripts/sync-autoru-catalog.js",
    "export:vehicle-seed": "node scripts/export-vehicle-seed.js",
    "import:carsbase-seed": "node scripts/import-carsbase-seed.js",
    "reload:vehicles": "node scripts/reload-vehicle-catalog.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "connect-pg-simple": "^10.0.0",
    "csurf": "^1.11.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "method-override": "^3.0.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
