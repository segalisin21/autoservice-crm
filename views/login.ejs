<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Вход</title>
    <link rel="stylesheet" href="/css/style.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>">
    <style>
      body.login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: var(--bg-page, #f3f4f6);
      }
      .login-card {
        width: 100%;
        max-width: 420px;
        background: var(--surface-elevated, #fff);
        border: 1px solid var(--border-subtle, #e5e7eb);
        border-radius: var(--radius-xl, 16px);
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
      }
      .login-brand { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; }
      .login-brand h1 { margin: 0; font-size: 1.25rem; }
      .login-error {
        margin-bottom: 1rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-md, 8px);
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #b91c1c;
      }
    </style>
  </head>
  <body class="login-page">
    <main class="login-card">
      <div class="login-brand">
        <span class="sidebar-logo-mark" aria-hidden="true">🔧</span>
        <div>
          <h1>Автосервис CRM</h1>
          <p class="muted" style="margin:0;">Вход в систему</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="login-error"><%= error %></div>
      <% } %>

      <form method="post" action="/login" class="form">
        <div class="form-group">
          <label>Логин</label>
          <input name="username" class="form-control" autocomplete="username" required />
        </div>
        <div class="form-group">
          <label>Пароль</label>
          <input type="password" name="password" class="form-control" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%; margin-top:0.5rem;">Войти</button>
      </form>
    </main>
  </body>
</html>
