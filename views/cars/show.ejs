<%- include('../partials/layout-top', { title: [car.make, car.model].filter(Boolean).join(' ') || 'Авто', user }) %>
<section class="card">
  <p><strong>Клиент:</strong> <a href="/clients/<%= car.client_id %>"><%= car.client_name %></a> (<%= car.client_phone %>)</p>
  <p><strong>VIN:</strong> <%= car.vin || '—' %></p>
  <p><strong>Номер:</strong> <%= car.license_plate_raw || '—' %> <span class="muted"><%= car.license_plate_normalized %></span></p>
  <p><strong>Год / пробег:</strong> <%= car.year || '—' %> / <%= car.mileage || '—' %></p>
  <% if (car.notes) { %><p><strong>Заметки:</strong> <%= car.notes %></p><% } %>
  <div style="margin-top:12px; display:flex; gap:8px;">
    <a class="btn" href="/cars/<%= car.id %>/edit">Редактировать</a>
    <form method="post" action="/cars/<%= car.id %>?_method=DELETE" onsubmit="return confirm('Удалить авто?');">
      <button type="submit" class="btn btn-delete">Удалить</button>
    </form>
  </div>
</section>
<section class="card">
  <h2 style="margin:0 0 12px 0; font-size:16px;">Заказ-наряды</h2>
  <% if (!orders.length) { %>
    <p class="muted">Заказов для этого авто пока нет.</p>
  <% } else { %>
  <div class="table-scroll">
    <table class="data-table data-table-compact">
      <thead>
        <tr>
          <th>№</th>
          <th>Дата</th>
          <th>Статус</th>
          <% if (typeof showMoney !== 'undefined' && showMoney) { %>
          <th class="num">Сумма</th>
          <th>Оплата</th>
          <% } %>
          <th>Работы</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <% const works = (orderWorks && orderWorks[o.id]) || []; %>
          <tr>
            <td><a href="/orders/<%= o.id %>">#<%= o.id %></a></td>
            <td><%= ((o.opened_at || o.created_at || '').toString().slice(0, 10)) %></td>
            <td><span class="status-badge status-<%= o.status %>"><%= (statusLabels && statusLabels[o.status]) || o.status %></span></td>
            <% if (typeof showMoney !== 'undefined' && showMoney) { %>
            <td class="num"><%= Number(o.total_price).toFixed(2) %> ₽</td>
            <td>
              <% if (o.due_amount > 0) { %>
                <span class="due-badge">Долг <%= Number(o.due_amount).toFixed(2) %> ₽</span>
              <% } else { %>
                <span class="muted">Оплачено</span>
              <% } %>
            </td>
            <% } %>
            <td>
              <% if (works.length) { %>
                <details class="car-order-works">
                  <summary><%= works.length %> <%= works.length === 1 ? 'работа' : (works.length < 5 ? 'работы' : 'работ') %></summary>
                  <ul class="car-order-works-list">
                    <% works.forEach(w => { %>
                      <li><%= w.name %><% if (Number(w.quantity) !== 1) { %> × <%= w.quantity %><% } %><% if (typeof showMoney !== 'undefined' && showMoney) { %> — <%= Number(w.total).toFixed(2) %> ₽<% } %></li>
                    <% }) %>
                  </ul>
                </details>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<section class="card">
  <h2 style="margin:0 0 12px 0; font-size:16px;">Напоминания</h2>
  <form method="post" action="/cars/<%= car.id %>/reminders">
    <label>Заголовок <input name="title" required /></label>
    <label>Дата <input name="due_date" type="date" /></label>
    <label>Заметка <input name="notes" /></label>
    <button type="submit" style="margin-top:12px;">Добавить</button>
  </form>
  <ul style="margin-top:16px; padding-left:18px;">
    <% reminders.forEach(r => { %>
      <li style="margin-bottom:8px;">
        <strong><%= r.title %></strong>
        <% if (r.due_date) { %> — <%= r.due_date %><% } %>
        <% if (r.is_done) { %><span class="muted"> (выполнено)</span><% } %>
        <form method="post" action="/cars/reminders/<%= r.id %>/toggle" style="display:inline;">
          <button type="submit"><%= r.is_done ? 'Вернуть' : 'Готово' %></button>
        </form>
        <form method="post" action="/cars/reminders/<%= r.id %>?_method=DELETE" style="display:inline;">
          <button type="submit">×</button>
        </form>
      </li>
    <% }) %>
  </ul>
</section>
<%- include('../partials/layout-bottom') %>
