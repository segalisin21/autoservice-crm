<%
  function formatDate(d) {
    return new Date(d + 'T12:00:00').toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }
  function formatMonthTitle(year, month0) {
    return new Date(year, month0, 1).toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' });
  }
  function statusLabel(s) {
    return { scheduled: 'Запись', in_progress: 'В работе', ready: 'Готов', completed: 'Завершён', cancelled: 'Отменён' }[s] || s;
  }
  var viewToday = (typeof today !== 'undefined' && today) ? today : new Date().toISOString().slice(0, 10);
  var viewMode = (typeof mode !== 'undefined' && mode === 'day') ? 'day' : 'month';
  var viewCalendar = (typeof calendar !== 'undefined' && calendar) ? calendar : null;
  var viewDayStats = (typeof dayStats !== 'undefined' && dayStats) ? dayStats : { count: 0, revenue: 0, employees_busy: 0, employees_total: 0 };
  var viewNav = (typeof nav !== 'undefined' && nav) ? nav : {};
  var viewDayData = (typeof dayData !== 'undefined') ? dayData : null;
  var viewFinance = (typeof finance !== 'undefined') ? finance : null;
  var viewShowMoney = (typeof showMoney !== 'undefined') ? showMoney : false;
  var pageTitle = (typeof title !== 'undefined' && title) ? title : (viewMode === 'day' ? 'Расписание' : 'Календарь');
  const weekLabels = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
  const firstWeekdayMon0 = viewCalendar && viewCalendar.days && viewCalendar.days.length
    ? ((viewCalendar.days[0].weekday + 6) % 7)
    : 0;
  const isDayView = viewMode === 'day';
  const empTotal = viewDayStats.employees_total || 0;
  const loadPct = empTotal > 0 ? Math.min(100, Math.round((viewDayStats.employees_busy || 0) / empTotal * 100)) : 0;
%>
<%- include('partials/layout-top', { title: pageTitle, category: 'dashboard', user }) %>

<div class="dashboard">
  <% if (typeof loadError !== 'undefined' && loadError) { %>
    <div class="error" style="margin-bottom:1rem;">
      Не удалось загрузить календарь: <%= loadError %>. Выполните <code>npm run migrate</code> и перезапустите сервер.
    </div>
  <% } %>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon bookings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
      </div>
      <div class="stat-content">
        <div class="stat-value"><%= viewDayStats.count %></div>
        <div class="stat-label">Заказов за день</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon revenue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div class="stat-content">
        <div class="stat-value"><%= Math.round(viewDayStats.revenue).toLocaleString('ru-RU') %> ₽</div>
        <div class="stat-label">Сумма за день</div>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div class="stat-content">
        <div class="stat-value"><%= viewDayStats.employees_busy %>/<%= empTotal %></div>
        <div class="stat-label">Сотрудников занято</div>
      </div>
    </div>
  </div>

  <% if (viewShowMoney && viewFinance) { %>
  <section class="dashboard-finance-panel dashboard-panel" aria-label="Финансы за месяц">
    <div class="dashboard-finance-head">
      <h3>Финансы за месяц</h3>
      <a href="/admin/finance?period=month" class="btn btn-secondary btn-sm">Подробнее →</a>
    </div>
    <div class="finance-kpi-grid finance-kpi-grid--compact">
      <div class="finance-kpi-card">
        <div class="finance-kpi-card__value"><%= Math.round(viewFinance.cash_in).toLocaleString('ru-RU') %>&nbsp;₽</div>
        <div class="finance-kpi-card__label">Касса</div>
      </div>
      <div class="finance-kpi-card">
        <div class="finance-kpi-card__value"><%= Math.round(viewFinance.net_revenue).toLocaleString('ru-RU') %>&nbsp;₽</div>
        <div class="finance-kpi-card__label">Выручка</div>
      </div>
      <div class="finance-kpi-card">
        <div class="finance-kpi-card__value"><%= Math.round(viewFinance.expenses_total).toLocaleString('ru-RU') %>&nbsp;₽</div>
        <div class="finance-kpi-card__label">Расходы</div>
      </div>
      <div class="finance-kpi-card finance-kpi-card--accent">
        <div class="finance-kpi-card__value"><%= Math.round(viewFinance.net_profit).toLocaleString('ru-RU') %>&nbsp;₽</div>
        <div class="finance-kpi-card__label">Прибыль</div>
      </div>
      <div class="finance-kpi-card">
        <div class="finance-kpi-card__value"><%= Math.round(viewFinance.receivables).toLocaleString('ru-RU') %>&nbsp;₽</div>
        <div class="finance-kpi-card__label">Дебиторка</div>
      </div>
    </div>
  </section>
  <% } %>

  <% if (!isDayView) { %>
  <div class="calendar-overview dashboard-panel" aria-label="Календарь">
    <div class="calendar-header">
      <div class="calendar-title">
        <h3><%= viewCalendar ? formatMonthTitle(viewCalendar.year, viewCalendar.month) : '' %></h3>
        <div class="calendar-subtitle">Нажмите день, чтобы открыть расписание по сотрудникам</div>
      </div>
      <div class="calendar-nav">
        <a class="btn btn-secondary btn-sm" href="/?mode=month&date=<%= viewNav.monthPrev || viewToday %>">←</a>
        <a class="btn btn-secondary btn-sm" href="/?mode=month&date=<%= viewNav.monthNext || viewToday %>">→</a>
        <a class="btn btn-primary btn-sm" href="/?mode=day&date=<%= viewToday %>">Сегодня</a>
      </div>
    </div>
    <div class="calendar-grid">
      <% weekLabels.forEach(function(w) { %>
        <div class="calendar-weekday"><%= w %></div>
      <% }); %>
      <% for (var i = 0; i < firstWeekdayMon0; i++) { %>
        <div class="calendar-day calendar-day--empty"></div>
      <% } %>
      <% (viewCalendar && viewCalendar.days ? viewCalendar.days : []).forEach(function(d) { %>
        <a
          class="calendar-day <%= d.date === viewToday ? 'calendar-day--selected' : '' %> <%= d.booking_count > 0 ? 'calendar-day--busy' : '' %>"
          href="/?mode=day&date=<%= d.date %>"
        >
          <div class="calendar-day-num"><%= d.day %></div>
          <% if (d.booking_count > 0) { %>
            <div class="calendar-day-meta">
              <span class="calendar-day-count"><%= d.booking_count %></span>
              <% if (d.revenue > 0) { %>
                <span class="calendar-day-rev"><%= Math.round(d.revenue).toLocaleString('ru-RU') %> ₽</span>
              <% } %>
            </div>
          <% } %>
        </a>
      <% }); %>
    </div>
  </div>
  <% } %>

  <% if (isDayView && viewDayData) { %>
  <div class="schedule-section dashboard-panel">
    <div class="schedule-header">
      <div class="date-nav">
        <a href="/?mode=day&date=<%= viewNav.prevDay || viewToday %>" class="date-nav-btn" title="Предыдущий день">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
        <h3>Расписание — <%= formatDate(viewToday) %></h3>
        <a href="/?mode=day&date=<%= viewNav.nextDay || viewToday %>" class="date-nav-btn" title="Следующий день">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M9 18l6-6-6-6"/></svg>
        </a>
        <a href="/?mode=month&date=<%= viewToday %>" class="btn btn-secondary btn-sm">Календарь</a>
        <a href="/?mode=day&date=<%= new Date().toISOString().slice(0,10) %>" class="btn btn-text btn-sm">Сегодня</a>
      </div>
      <div class="schedule-controls">
        <form method="get" action="/" style="display:flex; gap:0.5rem; align-items:center;">
          <input type="hidden" name="mode" value="day" />
          <input type="date" name="date" value="<%= viewToday %>" />
          <button type="submit" class="btn btn-primary btn-sm">Показать</button>
        </form>
        <a class="btn btn-primary btn-sm" href="/orders/new?scheduled_date=<%= viewToday %>">Новый заказ</a>
      </div>
    </div>

    <% if (viewDayData.unassigned && viewDayData.unassigned.length) { %>
    <div class="garage-unassigned">
      <div class="garage-bay-column">
        <div class="garage-bay-header">
          <span>Без сотрудника</span>
          <span class="garage-bay-count"><%= viewDayData.unassigned.length %></span>
        </div>
        <div class="garage-bay-body">
          <% viewDayData.unassigned.forEach(function(o) { %>
            <%- include('partials/order-card', { o: o, statusLabel: statusLabel }) %>
          <% }); %>
        </div>
      </div>
    </div>
    <% } %>

    <% if (!viewDayData.employees || !viewDayData.employees.length) { %>
      <p class="dashboard-empty muted">Нет активных сотрудников. Добавьте их в разделе «Сотрудники».</p>
    <% } %>

    <p class="only-mobile schedule-scroll-hint muted">Свайп влево — другие сотрудники</p>
    <div class="garage-day-grid schedule-day-scroll">
      <% (viewDayData.employees || []).forEach(function(emp) { %>
        <div class="garage-bay-column">
          <div class="garage-bay-header">
            <span><%= emp.name %></span>
            <span class="garage-bay-count"><%= emp.orders.length %></span>
          </div>
          <div class="garage-bay-body">
            <% if (!emp.orders.length) { %>
              <div class="garage-bay-empty">Свободно</div>
            <% } %>
            <% emp.orders.forEach(function(o) { %>
              <%- include('partials/order-card', { o: o, statusLabel: statusLabel }) %>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>

<%- include('partials/layout-bottom') %>
