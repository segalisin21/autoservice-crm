<%- include('../partials/layout-top', { title: 'Экономика заказов', user, category: 'finance', adminSection: 'economics' }) %>

<div class="admin-page finance-dashboard">
  <div class="finance-dashboard__head">
    <h1 class="finance-dashboard__title">Экономика по заказам</h1>
    <%- include('./_admin-subnav') %>
  </div>
  <p class="muted finance-dashboard__hint">Выручка, расходники, ЗП и прибыль по каждому заказу.</p>

  <form method="get" class="finance-dashboard__toolbar">
    <div class="finance-dashboard__toolbar-row">
      <div class="chip-row">
        <a class="chip <%= range.period === 'today' ? 'chip--active' : '' %>" href="/admin/orders-economics?period=today&status=<%= status %>">Сегодня</a>
        <a class="chip <%= range.period === 'week' ? 'chip--active' : '' %>" href="/admin/orders-economics?period=week&status=<%= status %>">Неделя</a>
        <a class="chip <%= !range.period || range.period === 'month' ? 'chip--active' : '' %>" href="/admin/orders-economics?period=month&status=<%= status %>">Месяц</a>
      </div>
      <label class="filter-group">
        <span class="filter-label">Статус</span>
        <select name="status" class="filter-select" onchange="this.form.submit()">
          <option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Завершённые</option>
          <option value="in_progress" <%= status === 'in_progress' ? 'selected' : '' %>>В работе</option>
          <option value="scheduled" <%= status === 'scheduled' ? 'selected' : '' %>>Запись</option>
          <option value="ready" <%= status === 'ready' ? 'selected' : '' %>>Готов</option>
          <option value="all" <%= status === 'all' ? 'selected' : '' %>>Все активные</option>
        </select>
      </label>
      <div class="finance-dashboard__dates">
        <input type="date" name="start_date" class="finance-dashboard__input" value="<%= range.start_date %>" />
        <span class="finance-dashboard__dates-sep">—</span>
        <input type="date" name="end_date" class="finance-dashboard__input" value="<%= range.end_date %>" />
        <button type="submit" class="btn btn-primary btn-sm">Показать</button>
      </div>
    </div>
  </form>

  <div class="finance-kpi-grid finance-kpi-grid--compact">
    <div class="finance-kpi-card">
      <div class="finance-kpi-card__value"><%= totals.revenue.toLocaleString('ru-RU') %>&nbsp;₽</div>
      <div class="finance-kpi-card__label">Выручка</div>
    </div>
    <div class="finance-kpi-card">
      <div class="finance-kpi-card__value"><%= totals.materials.toLocaleString('ru-RU') %>&nbsp;₽</div>
      <div class="finance-kpi-card__label">Расходники</div>
    </div>
    <div class="finance-kpi-card">
      <div class="finance-kpi-card__value"><%= totals.payroll.toLocaleString('ru-RU') %>&nbsp;₽</div>
      <div class="finance-kpi-card__label">ЗП</div>
    </div>
    <div class="finance-kpi-card finance-kpi-card--accent">
      <div class="finance-kpi-card__value"><%= totals.profit.toLocaleString('ru-RU') %>&nbsp;₽</div>
      <div class="finance-kpi-card__label">Прибыль</div>
    </div>
  </div>

  <% if (!orders.length) { %>
    <p class="finance-panel__empty muted">Нет заказов за период и фильтр.</p>
  <% } else { %>
  <div class="table-scroll order-econ-table-wrap">
    <table class="data-table order-econ-table">
      <thead>
        <tr>
          <th>№</th>
          <th>Дата</th>
          <th>Авто / клиент</th>
          <th>Статус</th>
          <th class="num">Выручка</th>
          <th class="num">Расходники</th>
          <th class="num">ЗП</th>
          <th class="num">Прибыль</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(row => { %>
          <tr>
            <td><a href="/orders/<%= row.order_id %>">#<%= row.order_id %></a></td>
            <td><%= (row.closed_at || row.scheduled_date || '').toString().slice(0, 10) %></td>
            <td>
              <div><%= row.car_label %></div>
              <div class="muted table-sub"><%= row.client_name %></div>
            </td>
            <td><span class="status-badge status-<%= row.status %>"><%= statusLabels[row.status] || row.status %></span></td>
            <td class="num"><%= Number(row.revenue).toLocaleString('ru-RU') %> ₽</td>
            <td class="num muted">−<%= Number(row.materials).toLocaleString('ru-RU') %> ₽</td>
            <td class="num muted">−<%= Number(row.payroll).toLocaleString('ru-RU') %> ₽<%= row.is_estimate ? ' ≈' : '' %></td>
            <td class="num"><strong><%= Number(row.profit).toLocaleString('ru-RU') %> ₽</strong></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="order-econ-totals">
          <td colspan="4"><strong>Итого</strong></td>
          <td class="num"><%= totals.revenue.toLocaleString('ru-RU') %> ₽</td>
          <td class="num">−<%= totals.materials.toLocaleString('ru-RU') %> ₽</td>
          <td class="num">−<%= totals.payroll.toLocaleString('ru-RU') %> ₽</td>
          <td class="num"><strong><%= totals.profit.toLocaleString('ru-RU') %> ₽</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</div>

<%- include('../partials/layout-bottom') %>
