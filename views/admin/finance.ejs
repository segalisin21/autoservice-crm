<%- include('../partials/layout-top', { title: 'Финансы', user, category: 'finance' }) %>
<section class="card">
  <form method="get" style="display:flex; gap:8px; flex-wrap:wrap;">
    <label>С <input type="date" name="start_date" value="<%= range.start_date %>" /></label>
    <label>По <input type="date" name="end_date" value="<%= range.end_date %>" /></label>
    <button type="submit" class="btn btn-primary btn-sm">Показать</button>
    <a class="btn btn-secondary btn-sm" href="/admin/finance/export?start_date=<%= range.start_date %>&end_date=<%= range.end_date %>">CSV</a>
  </form>
  <div style="margin-top:16px; display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:12px;">
    <div><span class="muted">Касса (cash-in)</span><br /><strong><%= metrics.cash_in.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Выручка (закрытые)</span><br /><strong><%= metrics.orders_net_by_closed_at.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Gross</span><br /><strong><%= metrics.gross_revenue.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Скидки</span><br /><strong><%= metrics.discounts_total.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Net (выручка)</span><br /><strong><%= metrics.net_revenue.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Расходы</span><br /><strong><%= metrics.expenses_total.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Прибыль</span><br /><strong><%= metrics.net_profit.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Налоги</span><br /><strong><%= metrics.taxes_total.toFixed(2) %> ₽</strong></div>
    <div><span class="muted">Дебиторка</span><br /><strong><%= metrics.receivables.toFixed(2) %> ₽</strong></div>
  </div>
</section>
<%- include('../partials/layout-bottom') %>
