<%
  function modeLabel(m) {
    return {
      net_percent: '% от (работы − расходники)',
      percent: '% от работы',
      fixed: 'фикс. сумма',
      hourly: 'почасово'
    }[m] || m;
  }
%>
<%- include('../partials/layout-top', { title: 'Зарплата', user, category: 'payroll', adminSection: 'payroll' }) %>
<div class="admin-page finance-dashboard">
  <div class="finance-dashboard__head">
    <h1 class="finance-dashboard__title">Зарплата</h1>
    <%- include('./_admin-subnav') %>
  </div>
<section class="card">
  <form method="get" style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
    <label>С <input type="date" name="start_date" value="<%= range.start_date %>" /></label>
    <label>По <input type="date" name="end_date" value="<%= range.end_date %>" /></label>
    <% if (user.role !== 'master') { %>
    <label>Мастер
      <select name="user_id">
        <option value="">Все</option>
        <% masters.forEach(m => { %>
          <option value="<%= m.id %>" <%= filterUserId === m.id ? 'selected' : '' %>><%= m.name %></option>
        <% }) %>
      </select>
    </label>
    <% } %>
    <button type="submit" class="btn btn-primary btn-sm">Показать</button>
  </form>
  <p class="muted" style="margin:8px 0 0;">Разверните сотрудника — начисления по работам, выплаты и быстрая запись выплаты на остаток.</p>
  <div class="payroll-accordion-list" style="margin-top:12px;">
    <% summary.forEach(s => {
      const detail = payrollDetails[s.id] || { earnedLines: [], payouts: [] };
    %>
      <details class="payroll-accordion">
        <summary class="payroll-accordion__summary">
          <span class="payroll-accordion__name"><%= s.name %></span>
          <span class="payroll-accordion__cell muted">Период: <%= (s.earned_period || 0).toFixed(0) %> / −<%= (s.paid_period || 0).toFixed(0) %></span>
          <span class="payroll-accordion__cell">К выплате <strong><%= (s.due_period || 0).toFixed(2) %> ₽</strong></span>
          <span class="payroll-accordion__cell <%= s.due_total > 0 ? 'text-due' : '' %>">Остаток <strong><%= s.due_total.toFixed(2) %> ₽</strong></span>
        </summary>
        <div class="payroll-accordion__body">
          <div class="payroll-kpi-row">
            <div><span class="muted">Начислено (период)</span><br /><strong><%= (s.earned_period || 0).toFixed(2) %> ₽</strong></div>
            <div><span class="muted">Выплачено (период)</span><br /><strong><%= (s.paid_period || 0).toFixed(2) %> ₽</strong></div>
            <div><span class="muted">Всего начислено</span><br /><%= s.earned_total.toFixed(2) %> ₽</div>
            <div><span class="muted">Всего выплачено</span><br /><%= s.paid_total.toFixed(2) %> ₽</div>
          </div>

          <% if (detail.earnedLines.length) { %>
          <h3 class="payroll-detail-title">Начисления по работам</h3>
          <div class="table-scroll">
            <table class="data-table data-table-compact">
              <thead>
                <tr><th>Дата</th><th>Заказ</th><th>Работа</th><th>Авто</th><th class="num">ЗП</th></tr>
              </thead>
              <tbody>
                <% detail.earnedLines.forEach(l => { %>
                  <tr>
                    <td><%= (l.closed_at || '').toString().slice(0, 10) %></td>
                    <td><a href="/orders/<%= l.order_id %>">#<%= l.order_id %></a></td>
                    <td><%= l.line_name %></td>
                    <td class="muted"><%= l.license_plate_raw || l.car_make || '—' %></td>
                    <td class="num"><%= Number(l.earned).toFixed(2) %> ₽</td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <p class="muted">Нет начислений за выбранный период.</p>
          <% } %>

          <% if (detail.payouts.length) { %>
          <h3 class="payroll-detail-title">Выплаты за период</h3>
          <div class="table-scroll">
            <table class="data-table data-table-compact">
              <thead><tr><th>Дата</th><th class="num">Сумма</th><th>Способ</th><th>Комментарий</th></tr></thead>
              <tbody>
                <% detail.payouts.forEach(p => { %>
                  <tr>
                    <td><%= (p.paid_at || '').toString().slice(0, 16) %></td>
                    <td class="num"><%= Number(p.amount).toFixed(2) %> ₽</td>
                    <td><%= p.method %></td>
                    <td><%= p.note || '—' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>

          <% if (canMutate) { %>
          <div class="payroll-quick-payout">
            <h3 class="payroll-detail-title">Быстрая выплата</h3>
            <form method="post" action="/admin/payroll/payouts" class="payroll-inline-payout-form">
              <input type="hidden" name="user_id" value="<%= s.id %>" />
              <label>Сумма
                <input name="amount" required inputmode="decimal" value="<%= s.due_total > 0 ? s.due_total.toFixed(2) : '' %>" placeholder="0" />
              </label>
              <label>Способ
                <select name="method">
                  <option value="cash">Наличные</option>
                  <option value="transfer">Перевод</option>
                  <option value="card">Карта</option>
                  <option value="other">Другое</option>
                </select>
              </label>
              <label>Период с <input type="date" name="period_start" value="<%= range.start_date %>" /></label>
              <label>по <input type="date" name="period_end" value="<%= range.end_date %>" /></label>
              <label>Комментарий <input name="note" placeholder="Расчёт, аванс…" /></label>
              <button type="submit" class="btn btn-primary btn-sm">Записать <%= s.due_total > 0 ? s.due_total.toFixed(0) + ' ₽' : 'выплату' %></button>
            </form>
          </div>
          <% } %>
        </div>
      </details>
    <% }) %>
  </div>
  <% if (!summary.length) { %>
    <p class="muted">Нет сотрудников для отображения.</p>
  <% } %>
</section>

<% if (canMutate) { %>
<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Формула по умолчанию</h2>
  <p class="muted" style="margin-top:0;">Применяется, если у мастера нет своего правила. По умолчанию: 50% от (работы − расходники).</p>
  <form method="post" action="/admin/payroll/default" style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end;">
    <label>Режим
      <select name="mode">
        <% modes.forEach(m => { %>
          <option value="<%= m %>" <%= payrollDefault.mode === m ? 'selected' : '' %>><%= modeLabel(m) %></option>
        <% }) %>
      </select>
    </label>
    <label>Значение <input name="value" value="<%= payrollDefault.value %>" /></label>
    <button type="submit" class="btn btn-primary btn-sm">Сохранить</button>
  </form>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Правило по мастеру (деактивирует предыдущее)</h2>
  <form method="post" action="/admin/payroll/rules">
    <label>Мастер
      <select name="user_id" required>
        <% masters.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Режим
      <select name="mode">
        <% modes.forEach(m => { %>
          <option value="<%= m %>"><%= modeLabel(m) %></option>
        <% }) %>
      </select>
    </label>
    <label>Значение <input name="value" required /></label>
    <label>С даты <input type="date" name="effective_from" value="<%= range.start_date %>" /></label>
    <button type="submit" class="btn btn-primary" style="margin-top:12px;">Сохранить правило</button>
  </form>
  <% if (rules && rules.length) { %>
  <table style="margin-top:16px;">
    <thead><tr><th>Мастер</th><th>Режим</th><th>Значение</th><th>С даты</th></tr></thead>
    <tbody>
      <% rules.forEach(r => { %>
        <tr>
          <td><%= r.user_name %></td>
          <td><%= modeLabel(r.mode) %></td>
          <td><%= Number(r.value) %></td>
          <td><%= r.effective_from %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Оплата за конкретную работу (фикс/процент)</h2>
  <form method="post" action="/admin/payroll/overrides">
    <label>Мастер
      <select name="user_id" required>
        <% masters.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Работа
      <select name="catalog_item_id" required>
        <% works.forEach(w => { %>
          <option value="<%= w.id %>"><%= w.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Режим
      <select name="mode">
        <% modes.forEach(m => { %>
          <option value="<%= m %>"><%= modeLabel(m) %></option>
        <% }) %>
      </select>
    </label>
    <label>Значение <input name="value" required /></label>
    <button type="submit" class="btn btn-primary" style="margin-top:12px;">Сохранить переопределение</button>
  </form>
  <% if (overrides && overrides.length) { %>
  <table style="margin-top:16px;">
    <thead><tr><th>Мастер</th><th>Работа</th><th>Режим</th><th>Значение</th><th></th></tr></thead>
    <tbody>
      <% overrides.forEach(o => { %>
        <tr>
          <td><%= o.user_name %></td>
          <td><%= o.item_name %></td>
          <td><%= modeLabel(o.mode) %></td>
          <td><%= Number(o.value) %></td>
          <td>
            <form method="post" action="/admin/payroll/overrides/<%= o.id %>?_method=DELETE" style="display:inline;">
              <button type="submit">×</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Записать выплату</h2>
  <form method="post" action="/admin/payroll/payouts" class="payout-form">
    <label>Мастер
      <select name="user_id" required id="payout-user-select">
        <% summary.forEach(s => { %>
          <option value="<%= s.id %>" data-due="<%= s.due_total %>"><%= s.name %> (остаток <%= s.due_total.toFixed(0) %> ₽)</option>
        <% }) %>
        <% if (!summary.length) { masters.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.name %></option>
        <% }) } %>
      </select>
    </label>
    <label>Сумма <input name="amount" id="payout-amount" required inputmode="decimal" /></label>
    <label>Способ
      <select name="method">
        <option value="cash">Наличные</option>
        <option value="transfer">Перевод</option>
        <option value="card">Карта</option>
        <option value="other">Другое</option>
      </select>
    </label>
    <label>Период ЗП с <input type="date" name="period_start" value="<%= range.start_date %>" /></label>
    <label>по <input type="date" name="period_end" value="<%= range.end_date %>" /></label>
    <label>Комментарий <input name="note" placeholder="Аванс, расчёт…" /></label>
    <button type="submit" class="btn btn-primary" style="margin-top:12px;">Записать выплату</button>
  </form>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">История выплат</h2>
  <% if (recentPayouts && recentPayouts.length) { %>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Дата</th><th>Мастер</th><th>Сумма</th><th>Период ЗП</th><th>Способ</th><th>Комментарий</th></tr></thead>
      <tbody>
        <% recentPayouts.forEach(p => { %>
          <tr>
            <td><%= (p.paid_at || '').toString().slice(0, 16) %></td>
            <td><%= p.user_name %></td>
            <td><%= Number(p.amount).toFixed(2) %> ₽</td>
            <td class="muted"><% if (p.period_start && p.period_end) { %><%= p.period_start %> — <%= p.period_end %><% } else { %>—<% } %></td>
            <td><%= p.method %></td>
            <td><%= p.note || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <p class="muted">Выплат пока нет.</p>
  <% } %>
</section>
<% } %>
<script>
(function () {
  var sel = document.getElementById("payout-user-select");
  var amt = document.getElementById("payout-amount");
  if (!sel || !amt) return;
  function fillDue() {
    var opt = sel.options[sel.selectedIndex];
    var due = opt && opt.getAttribute("data-due");
    if (due && !amt.value) amt.value = due;
  }
  sel.addEventListener("change", function () { amt.value = ""; fillDue(); });
  fillDue();
})();
</script>
</div>
<%- include('../partials/layout-bottom') %>
