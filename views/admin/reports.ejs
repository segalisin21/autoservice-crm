<%- include('../partials/layout-top', { title: 'Аналитика', user, category: 'reports', adminSection: 'reports' }) %>

<div class="admin-page admin-page--reports">
  <div class="page-header page-header--stack">
    <div class="page-header-top">
      <div class="page-header-title">
        <h3>Аналитика</h3>
        <div class="sub-text">Заказы автосервиса · графики и экспорт</div>
      </div>
      <div class="dropdown">
        <button type="button" class="btn btn-secondary" onclick="this.nextElementSibling.classList.toggle('show')">Экспорт</button>
        <div class="dropdown-menu">
          <a href="/admin/reports/export?type=orders&start_date=<%= startDate %>&end_date=<%= endDate %>" class="dropdown-item">Заказы (CSV)</a>
          <a href="/admin/reports/export?type=top_services&start_date=<%= startDate %>&end_date=<%= endDate %>" class="dropdown-item">Топ услуг (CSV)</a>
          <a href="/admin/reports/export?type=finance&start_date=<%= startDate %>&end_date=<%= endDate %>" class="dropdown-item">Финансы (CSV)</a>
        </div>
      </div>
    </div>
    <%- include('./_admin-subnav') %>
    <div class="filters-bar">
      <form method="GET" class="filters-form filters-form--reports" id="reportFilter">
        <div class="filter-group">
          <label class="filter-label" for="report-period">Период</label>
          <select name="period" id="report-period" class="filter-select">
            <option value="7" <%= period === '7' ? 'selected' : '' %>>7 дней</option>
            <option value="30" <%= period === '30' ? 'selected' : '' %>>30 дней</option>
            <option value="90" <%= period === '90' ? 'selected' : '' %>>90 дней</option>
            <option value="custom" <%= period === 'custom' ? 'selected' : '' %>>Свой диапазон</option>
          </select>
        </div>
        <div class="filter-group report-date-range">
          <label class="filter-label">Даты</label>
          <input type="date" name="start_date" class="filter-input" value="<%= startDate %>" aria-label="Дата с" />
          <span class="report-date-sep">—</span>
          <input type="date" name="end_date" class="filter-input" value="<%= endDate %>" aria-label="Дата по" />
          <button type="button" class="btn btn-secondary btn-sm" id="btn-apply-range">Применить диапазон</button>
        </div>
        <p class="report-range-hint">Операционные KPI — по дате записи заказа; выручка и касса — по закрытию и оплатам. Пресеты — скользящее окно до сегодня.</p>
      </form>
    </div>
  </div>

  <div class="stats-row" id="stats-overview">
    <div class="stat-card stat-blue">
      <div class="stat-value"><%= overview.totalOrders %></div>
      <div class="stat-label">Заказов (не отменённых)</div>
    </div>
    <div class="stat-card stat-green">
      <div class="stat-value"><%= overview.totalRevenue.toLocaleString('ru-RU') %> ₽</div>
      <div class="stat-label">Выручка (завершённые)</div>
    </div>
    <div class="stat-card stat-purple">
      <div class="stat-value"><%= overview.avgBookingValue.toLocaleString('ru-RU') %> ₽</div>
      <div class="stat-label">Средний чек</div>
    </div>
    <div class="stat-card stat-orange">
      <div class="stat-value"><%= overview.completedBookings %></div>
      <div class="stat-label">Завершено</div>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-card stat-analytics-retained">
      <div class="stat-value"><%= overview.cancelledBookings %></div>
      <div class="stat-label">Отменено за период</div>
    </div>
    <div class="stat-card stat-analytics-retained-sum">
      <div class="stat-value"><%= overview.cashIn.toLocaleString('ru-RU') %> ₽</div>
      <div class="stat-label">Касса за период</div>
    </div>
  </div>

  <div class="charts-grid charts-grid--analytics">
    <div class="chart-card">
      <h4>Выручка и заказы по дням</h4>
      <p class="chart-sub">Столбцы — выручка (₽), линия — число завершённых заказов по дате закрытия.</p>
      <div class="chart-wrap"><canvas id="revenueChart"></canvas></div>
    </div>
    <div class="chart-card">
      <h4>Месяцы: выручка и заказы</h4>
      <p class="chart-sub">Последние 12 месяцев (не зависит от фильтра периода).</p>
      <div class="chart-wrap"><canvas id="monthlyChart"></canvas></div>
    </div>
  </div>

  <div class="charts-grid charts-grid--analytics">
    <div class="chart-card chart-card--span-wide">
      <h4>Популярность часов начала работ</h4>
      <p class="chart-sub">По полю «Начало» в заказах за выбранный период (дата записи)</p>
      <div class="chart-wrap chart-wrap--hours"><canvas id="orderHourChart"></canvas></div>
    </div>
  </div>

  <div class="charts-grid charts-grid--analytics">
    <div class="chart-card chart-card--donut">
      <h4>Выручка по типу работ</h4>
      <div class="chart-wrap chart-wrap--donut"><canvas id="categoryChart"></canvas></div>
    </div>
    <div class="chart-card chart-card--donut">
      <h4>Статусы заказов</h4>
      <div class="chart-wrap chart-wrap--donut"><canvas id="statusChart"></canvas></div>
    </div>
  </div>

  <div class="charts-grid charts-grid--analytics">
    <div class="chart-card">
      <h4>Оплата завершённых заказов</h4>
      <p class="chart-sub">Сумма заказов в ₽ по категории оплаты</p>
      <div class="chart-wrap chart-wrap--horizontal"><canvas id="paymentChart"></canvas></div>
    </div>
    <div class="chart-card">
      <h4>Топ услуг по выручке</h4>
      <div class="chart-wrap chart-wrap--horizontal"><canvas id="topServicesChart"></canvas></div>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card">
      <h4>По типу работ</h4>
      <table class="mini-table">
        <thead><tr><th>Тип</th><th>Заказов</th><th>Выручка</th></tr></thead>
        <tbody>
          <% revenueByCategory.forEach(function(row) { %>
            <tr>
              <td><%= row.category %></td>
              <td><%= row.bookings_count %></td>
              <td><%= row.revenue.toLocaleString('ru-RU') %> ₽</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="table-card">
      <h4>Статусы</h4>
      <table class="mini-table">
        <thead><tr><th>Статус</th><th>Кол-во</th></tr></thead>
        <tbody>
          <% statusDist.forEach(function(row) { %>
            <tr><td><%= row.label %></td><td><%= row.count %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card">
      <h4>Топ услуги</h4>
      <table class="mini-table">
        <thead><tr><th>Услуга</th><th>Кол-во</th><th>Выручка</th></tr></thead>
        <tbody>
          <% topServices.forEach(function(row) { %>
            <tr>
              <td><%= row.name %></td>
              <td><%= row.times_booked %></td>
              <td><%= Number(row.revenue).toLocaleString('ru-RU') %> ₽</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="table-card">
      <h4>Топ клиенты</h4>
      <table class="mini-table">
        <thead><tr><th>Клиент</th><th>Заказов</th><th>Сумма</th></tr></thead>
        <tbody>
          <% topClients.forEach(function(row) { %>
            <tr>
              <td><%= row.full_name %></td>
              <td><%= row.total_bookings %></td>
              <td><%= row.total_spent.toLocaleString('ru-RU') %> ₽</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
window.REPORT_BOOTSTRAP = {
  revenueByDay: <%- revenueByDay %>,
  monthlyComparison: <%- monthlyComparison %>,
  revenueByCategory: <%- revenueByCategoryJson %>,
  statusDist: <%- statusDistJson %>,
  paymentDist: <%- paymentDistJson %>,
  topServices: <%- topServicesJson %>,
  orderHourDist: <%- orderHourDistJson %>
};
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script src="/js/admin-reports.js"></script>

<%- include('../partials/layout-bottom') %>
