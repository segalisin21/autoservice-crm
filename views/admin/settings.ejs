<%- include('../partials/layout-top', { title: 'Настройки', user, category: 'settings', adminSection: 'settings' }) %>
<div class="admin-page">
  <h1 class="finance-dashboard__title" style="margin-bottom:16px;">Настройки</h1>

  <% if (saved) { %>
    <div class="success-banner" style="margin-bottom:16px;">Настройки сохранены.</div>
  <% } %>

  <section class="card">
    <h2 style="margin:0 0 8px 0; font-size:16px;">Справочник автомобилей</h2>
    <p class="muted" style="margin-top:0;">
      Данные загружаются с cars-base.ru с обоими вариантами названий. Переключатель меняет только отображение в формах и поиске.
    </p>
    <form method="post" action="/admin/settings">
    <%- include('../partials/csrf-field') %>
      <fieldset style="border:0; padding:0; margin:12px 0 0;">
        <legend class="muted" style="margin-bottom:8px;">Названия марок и моделей</legend>
        <label style="display:block; margin-bottom:8px;">
          <input type="radio" name="vehicle_catalog_names" value="original" <%= vehicleCatalog.vehicle_catalog_names === 'original' ? 'checked' : '' %> />
          Оригинальные (Toyota, Camry)
        </label>
        <label style="display:block;">
          <input type="radio" name="vehicle_catalog_names" value="cyrillic" <%= vehicleCatalog.vehicle_catalog_names === 'cyrillic' ? 'checked' : '' %> />
          Кириллица (Тойота, Камри)
        </label>
      </fieldset>
      <button type="submit" class="btn btn-primary btn-sm" style="margin-top:16px;">Сохранить</button>
    </form>
    <p class="muted" style="margin:16px 0 0; font-size:13px;">
      После обновления справочника с cars-base выполните «Обновить справочник авто» в разделе Каталог или <code>npm run reload:vehicles</code>.
    </p>
  </section>
</div>
<%- include('../partials/layout-bottom') %>
