<%- include('../partials/layout-top', { title: 'Анализ рынка', user, category: 'market', adminSection: 'market' }) %>

<%
  function money(v) {
    if (v === null || v === undefined || v === '') return '—';
    return Number(v).toLocaleString('ru-RU') + ' ₽';
  }
  function positionLabel(p) {
    if (p === 'below') return 'Ниже рынка';
    if (p === 'above') return 'Выше рынка';
    if (p === 'in') return 'В рынке';
    return 'Нет цены';
  }
  function deltaLabel(d) {
    if (d === null || d === undefined) return '—';
    return (d > 0 ? '+' : '') + d + '%';
  }
%>

<div class="admin-page admin-page--market">
  <div class="page-header page-header--stack">
    <div class="page-header-top">
      <div class="page-header-title">
        <h3>Анализ рынка</h3>
        <div class="sub-text">Услуги CRM против рынка · срез <%= snapshotDate %></div>
      </div>
    </div>
    <%- include('./_admin-subnav') %>
    <div class="filters-bar">
      <form method="GET" class="filters-form filters-form--reports" id="marketFilter">
        <div class="filter-group">
          <label class="filter-label" for="market-service">Направление</label>
          <select name="service" id="market-service" class="filter-select">
            <option value="all" <%= service === 'all' ? 'selected' : '' %>>Все направления</option>
            <% serviceGroups.forEach(function (g) { %>
              <option value="<%= g.id %>" <%= service === g.id ? 'selected' : '' %>><%= g.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="market-geography">География</label>
          <select name="geography" id="market-geography" class="filter-select">
            <option value="all" <%= geography === 'all' ? 'selected' : '' %>>Вся география</option>
            <% geographies.forEach(function (g) { %>
              <option value="<%= g.id %>" <%= geography === g.id ? 'selected' : '' %>><%= g.label %></option>
            <% }) %>
          </select>
        </div>
        <p class="report-range-hint">Ручной срез публичных прайсов, 2ГИС и агрегаторов. Не live-парсинг. Цены «от» ≠ финальная смета. Наши цены — живые из каталога.</p>
      </form>
    </div>
  </div>

  <div class="stats-row" id="market-kpi">
    <div class="stat-card stat-blue market-kpi-card" data-position-filter="all" tabindex="0" role="button" title="Показать все услуги">
      <div class="stat-value" data-kpi="matchedLabel"><%= kpi.matchedLabel %></div>
      <div class="stat-label">Услуг сопоставлено с рынком</div>
    </div>
    <div class="stat-card stat-green market-kpi-card" data-position-filter="below" tabindex="0" role="button" title="Показать услуги ниже рынка">
      <div class="stat-value" data-kpi="below"><%= kpi.below %></div>
      <div class="stat-label">Ниже рынка — резерв цены</div>
    </div>
    <div class="stat-card stat-orange market-kpi-card" data-position-filter="above" tabindex="0" role="button" title="Показать услуги выше рынка">
      <div class="stat-value" data-kpi="above"><%= kpi.above %></div>
      <div class="stat-label">Выше рынка — риск потока</div>
    </div>
    <div class="stat-card stat-purple">
      <div class="stat-value" data-kpi="notInCatalog"><%= kpi.notInCatalog %></div>
      <div class="stat-label">Продаём, но нет в каталоге</div>
    </div>
    <div class="stat-card stat-blue">
      <div class="stat-value" data-kpi="medianDeltaPct"><%= deltaLabel(kpi.medianDeltaPct) %></div>
      <div class="stat-label">Медианное отклонение от рынка</div>
    </div>
  </div>

  <div class="charts-grid charts-grid--analytics charts-grid--single" id="market-chart-card">
    <div class="chart-card">
      <div class="market-chart-head">
        <div>
          <h4 id="market-chart-title">Наша цена против рынка</h4>
          <p class="chart-sub" id="market-chart-desc">Наша цена (каталог или факт по заказам) и середина типичного рыночного диапазона, ₽.</p>
        </div>
        <div class="market-chart-toolbar" id="market-chart-toolbar">
          <div class="filter-group">
            <label class="filter-label" for="market-chart-type">График</label>
            <select id="market-chart-type" class="filter-select filter-select--compact">
              <option value="compare">Цены: мы vs рынок</option>
              <option value="delta">Отклонение, %</option>
              <option value="distribution">Распределение позиций</option>
            </select>
          </div>
          <div class="filter-group" data-chart-opt="bar">
            <label class="filter-label" for="market-chart-sort">Сортировка</label>
            <select id="market-chart-sort" class="filter-select filter-select--compact">
              <option value="deviation_desc">По отклонению ↓</option>
              <option value="deviation_asc">По отклонению ↑</option>
              <option value="price_desc">По нашей цене ↓</option>
              <option value="name">По названию</option>
            </select>
          </div>
          <div class="filter-group" data-chart-opt="bar">
            <label class="filter-label" for="market-chart-limit">Показать</label>
            <select id="market-chart-limit" class="filter-select filter-select--compact">
              <option value="6">6 услуг</option>
              <option value="12" selected>12 услуг</option>
              <option value="20">20 услуг</option>
              <option value="all">Все</option>
            </select>
          </div>
          <div class="filter-group">
            <label class="filter-label" for="market-chart-position">Позиция</label>
            <select id="market-chart-position" class="filter-select filter-select--compact">
              <option value="all">Все</option>
              <option value="below">Ниже рынка</option>
              <option value="in">В рынке</option>
              <option value="above">Выше рынка</option>
            </select>
          </div>
          <button type="button" class="btn market-chart-reset" id="market-chart-reset" title="Сбросить фильтры графика">Сброс</button>
        </div>
      </div>
      <p class="chart-sub chart-sub--note" id="market-chart-note" hidden></p>
      <div class="chart-wrap chart-wrap--market" id="market-chart-wrap"><canvas id="marketPositionChart"></canvas></div>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card table-card--wide">
      <h4>Цены: мы и рынок</h4>
      <div class="table-scroll">
        <table class="mini-table data-table-compact" id="market-price-table">
          <thead>
            <tr>
              <th data-sort="name">Услуга</th>
              <th>Единица</th>
              <th class="num" data-sort="effectivePrice">Наша цена</th>
              <th>Рынок: мин – типично – макс</th>
              <th class="num" data-sort="deltaPct">Отклонение</th>
              <th data-sort="position">Позиция</th>
              <th>Конкуренты</th>
              <th>Комментарий</th>
            </tr>
          </thead>
          <tbody>
            <% if (!rows.length) { %>
              <tr><td colspan="8">Нет строк для выбранных фильтров</td></tr>
            <% } %>
            <% rows.forEach(function (row) { %>
              <tr>
                <td><%= row.name %></td>
                <td><%= row.unit %></td>
                <td class="num">
                  <%= money(row.effectivePrice) %>
                  <% if (row.priceSource === 'orders') { %>
                    <span class="muted market-price-src">факт</span>
                  <% } else if (row.priceSource === 'none') { %>
                    <span class="muted market-price-src">нет услуги</span>
                  <% } else if (row.ourPriceMax && row.ourPriceMax > row.ourPrice) { %>
                    <span class="muted market-price-src">до <%= Number(row.ourPriceMax).toLocaleString('ru-RU') %></span>
                  <% } %>
                </td>
                <td><%= money(row.min) %> – <%= money(row.typicalLow) %>…<%= money(row.typicalHigh) %> – <%= money(row.high) %></td>
                <td class="num"><%= deltaLabel(row.deltaPct) %></td>
                <td><span class="market-pos market-pos--<%= row.position %>"><%= positionLabel(row.position) %></span></td>
                <td class="muted"><%= row.competitors %></td>
                <td class="muted"><%= row.note %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card" id="market-gaps-card">
      <h4>Продаём, но нет в каталоге</h4>
      <p class="chart-sub">Цена берётся из истории заказов — позицию стоит занести в каталог, чтобы управлять прайсом.</p>
      <table class="mini-table data-table-compact" id="market-gaps-table">
        <thead><tr><th>Услуга</th><th class="num">Факт: мин</th><th class="num">Средняя</th><th class="num">Макс</th><th class="num">Заказов</th></tr></thead>
        <tbody>
          <% if (!gaps.length) { %>
            <tr><td colspan="5">Все услуги этого фильтра есть в каталоге</td></tr>
          <% } %>
          <% gaps.forEach(function (row) { %>
            <tr>
              <td><%= row.name %></td>
              <td class="num"><%= money(row.fact && row.fact.min) %></td>
              <td class="num"><%= money(row.fact && row.fact.avg) %></td>
              <td class="num"><%= money(row.fact && row.fact.max) %></td>
              <td class="num"><%= row.fact ? row.fact.count : 0 %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="muted" style="margin-top:8px;"><a href="/catalog">Открыть каталог →</a></p>
    </div>
    <div class="table-card" id="market-niches-card">
      <h4>Ниши без нашего предложения</h4>
      <table class="mini-table data-table-compact" id="market-niches-table">
        <thead><tr><th>Услуга</th><th>Цена локально</th><th>Кто делает</th><th>Почему нам подходит</th></tr></thead>
        <tbody>
          <% niches.forEach(function (row) { %>
            <tr>
              <td><%= row.name %></td>
              <td><%= row.localPrice %></td>
              <td class="muted"><%= row.competitors %></td>
              <td class="muted"><%= row.why %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card table-card--wide">
      <h4>Рекомендации по цене</h4>
      <div class="table-scroll">
        <table class="mini-table data-table-compact" id="market-advice-table">
          <thead>
            <tr><th>Услуга</th><th>Сейчас</th><th>Предлагается</th><th>Обоснование</th></tr>
          </thead>
          <tbody>
            <% priceAdvice.forEach(function (row) { %>
              <tr>
                <td><%= row.service %></td>
                <td><%= row.current %></td>
                <td><strong><%= row.suggested %></strong></td>
                <td class="muted"><%= row.reason %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="tables-grid">
    <div class="table-card market-tips-card">
      <h4>Выводы</h4>
      <ul class="market-tips-list" id="market-tips">
        <% tips.forEach(function (tip) { %>
          <li><%= tip %></li>
        <% }) %>
      </ul>
    </div>
    <div class="table-card">
      <h4>Источники среза</h4>
      <table class="mini-table data-table-compact">
        <thead><tr><th>Источник</th><th>Что смотрели</th></tr></thead>
        <tbody>
          <% sources.forEach(function (row) { %>
            <tr><td><%= row.name %></td><td class="muted"><%= row.scope %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
window.MARKET_BOOTSTRAP = <%- marketBootstrap %>;
</script>
<script src="/vendor/chart.js/chart.umd.min.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
<script src="/js/admin-market.js"></script>

<%- include('../partials/layout-bottom') %>
