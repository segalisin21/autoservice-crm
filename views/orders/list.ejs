<%- include('../partials/layout-top', { title: 'Заказы', user, category: 'orders' }) %>
<%
  const now = new Date();
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().slice(0, 10);
  const monthEnd = new Date(now.getFullYear(), now.getMonth() + 1, 0).toISOString().slice(0, 10);
  const rangeStart = totalCount ? (page - 1) * pageSize + 1 : 0;
  const rangeEnd = totalCount ? Math.min(page * pageSize, totalCount) : 0;
%>
<section class="card">
  <form method="get" class="form-inline orders-filter-form orders-filter-form--compact">
    <input name="search" placeholder="№, клиент, телефон, госномер" value="<%= filters.search || '' %>" class="orders-search-input grow-field" />
    <select name="status">
      <option value="">Все статусы</option>
      <% statuses.forEach(s => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= (statusLabels && statusLabels[s]) || s %></option>
      <% }) %>
    </select>
    <select name="assigned_user_id">
      <option value="">Все сотрудники</option>
      <% (masters || []).forEach(m => { %>
        <option value="<%= m.id %>" <%= String(filters.assigned_user_id || '') === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
      <% }) %>
    </select>
    <input type="date" name="date_from" value="<%= filters.date_from || '' %>" title="Дата с" aria-label="Дата с" />
    <input type="date" name="date_to" value="<%= filters.date_to || '' %>" title="Дата по" aria-label="Дата по" />
    <label class="orders-filter-due">
      <input type="checkbox" name="due_only" value="1" <%= filters.due_only ? 'checked' : '' %> /> С долгом
    </label>
    <div class="form-inline__actions">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <% if (typeof exportQuery !== 'undefined' && exportQuery) { %>
      <a href="/orders/export.csv?<%= exportQuery %>" class="btn btn-secondary btn-sm">CSV</a>
      <% } else { %>
      <a href="/orders/export.csv" class="btn btn-secondary btn-sm">CSV</a>
      <% } %>
      <a href="/orders/new" class="btn btn-secondary btn-sm">+ Заказ</a>
    </div>
  </form>
  <div class="form-inline" style="margin-top:8px; gap:0.5rem;">
    <a class="chip <%= !filters.date_from && !filters.date_to ? 'chip--active' : '' %>" href="/orders<%= listQuery(1, { date_from: '', date_to: '' }) %>">Все</a>
    <a class="chip <%= filters.date_from === monthStart && filters.date_to === monthEnd ? 'chip--active' : '' %>" href="/orders<%= listQuery(1, { date_from: monthStart, date_to: monthEnd }) %>">Этот месяц</a>
    <a class="chip <%= filters.due_only && !filters.date_from && !filters.date_to ? 'chip--active' : '' %>" href="/orders<%= listQuery(1, { due_only: true, date_from: '', date_to: '' }) %>">С долгом</a>
  </div>

  <% if (!orders.length) { %>
    <p class="muted" style="margin-top:12px;">Заказов не найдено.</p>
  <% } else { %>
  <p class="muted" style="margin-top:12px;">Показано <%= rangeStart %>–<%= rangeEnd %> из <%= totalCount %></p>
  <div class="table-scroll orders-table-wrap">
    <table class="data-table data-table-compact orders-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Открыт</th>
          <th>Сотрудник</th>
          <th>Госномер</th>
          <th>Марка</th>
          <th>Модель</th>
          <th>Клиент</th>
          <th>Телефон</th>
          <th>Статус</th>
          <% if (typeof showMoney !== 'undefined' && showMoney) { %>
          <th class="num">Итого</th>
          <th class="num">Долг</th>
          <% } %>
          <% if (typeof can !== 'undefined' && can('orders:mutate')) { %><th></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr class="orders-table__row" onclick="window.location='/orders/<%= o.id %>'">
            <td><a href="/orders/<%= o.id %>" onclick="event.stopPropagation()"><%= o.id %></a></td>
            <td><%= (o.opened_at || '').toString().slice(0, 10) %></td>
            <td><%= o.assigned_user_name || '—' %></td>
            <td><%= o.license_plate_raw || (o.car_id ? '—' : 'не указано') %></td>
            <td><%= o.car_make || '—' %></td>
            <td><%= o.car_model || '—' %></td>
            <td><%= o.client_name || '—' %></td>
            <td class="muted"><%- include('../partials/phone-links', { phone: o.client_phone }) %></td>
            <td><span class="status-badge status-<%= o.status %>"><%= (statusLabels && statusLabels[o.status]) || o.status %></span></td>
            <% if (typeof showMoney !== 'undefined' && showMoney) { %>
            <td class="num"><%= Number(o.total_price).toFixed(2) %> ₽</td>
            <td class="num">
              <% if (o.due_amount > 0) { %>
                <span class="due-badge"><%= Number(o.due_amount).toFixed(2) %> ₽</span>
              <% } else { %>
                <span class="muted">0</span>
              <% } %>
            </td>
            <% } %>
            <% if (typeof can !== 'undefined' && can('orders:mutate')) { %>
            <td>
              <form method="post" action="/orders/<%= o.id %>?_method=DELETE" onclick="event.stopPropagation()" onsubmit="return confirm('Удалить заказ #<%= o.id %>?');">
    <%- include('../partials/csrf-field') %>
                <button type="submit" class="btn btn-sm btn-delete" title="Удалить">×</button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (totalPages > 1) { %>
  <nav class="pagination" aria-label="Страницы заказов">
    <% if (page > 1) { %>
      <a class="page-link" href="/orders<%= listQuery(page - 1) %>">← Назад</a>
    <% } %>
    <% for (let p = Math.max(1, page - 2); p <= Math.min(totalPages, page + 2); p++) { %>
      <a class="page-link <%= p === page ? 'active' : '' %>" href="/orders<%= listQuery(p) %>"><%= p %></a>
    <% } %>
    <% if (page < totalPages) { %>
      <a class="page-link" href="/orders<%= listQuery(page + 1) %>">Вперёд →</a>
    <% } %>
  </nav>
  <% } %>
  <% } %>
</section>
<%- include('../partials/layout-bottom') %>
