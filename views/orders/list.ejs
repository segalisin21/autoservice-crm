<%- include('../partials/layout-top', { title: 'Заказы', user, category: 'orders' }) %>
<section class="card">
  <form method="get" class="form-inline orders-filter-form orders-filter-form--compact">
    <input name="search" placeholder="№, клиент, телефон, госномер" value="<%= filters.search || '' %>" class="orders-search-input grow-field" />
    <select name="status">
      <option value="">Все статусы</option>
      <% statuses.forEach(s => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= (statusLabels && statusLabels[s]) || s %></option>
      <% }) %>
    </select>
    <select name="assigned_user_id">
      <option value="">Все сотрудники</option>
      <% (masters || []).forEach(m => { %>
        <option value="<%= m.id %>" <%= String(filters.assigned_user_id || '') === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
      <% }) %>
    </select>
    <label class="orders-filter-due">
      <input type="checkbox" name="due_only" value="1" <%= filters.due_only ? 'checked' : '' %> /> С долгом
    </label>
    <div class="form-inline__actions">
      <button type="submit" class="btn btn-primary btn-sm">Найти</button>
      <a href="/orders/new" class="btn btn-secondary btn-sm">+ Заказ</a>
    </div>
  </form>

  <% if (!orders.length) { %>
    <p class="muted" style="margin-top:12px;">Заказов не найдено.</p>
  <% } else { %>
  <div class="table-scroll orders-table-wrap">
    <table class="data-table data-table-compact orders-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Открыт</th>
          <th>Сотрудник</th>
          <th>Госномер</th>
          <th>Марка</th>
          <th>Модель</th>
          <th>Клиент</th>
          <th>Телефон</th>
          <th>Статус</th>
          <% if (typeof showMoney !== 'undefined' && showMoney) { %>
          <th class="num">Итого</th>
          <th class="num">Долг</th>
          <% } %>
          <% if (typeof can !== 'undefined' && can('orders:mutate')) { %><th></th><% } %>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr class="orders-table__row" onclick="window.location='/orders/<%= o.id %>'">
            <td><a href="/orders/<%= o.id %>" onclick="event.stopPropagation()"><%= o.id %></a></td>
            <td><%= (o.opened_at || '').toString().slice(0, 10) %></td>
            <td><%= o.assigned_user_name || '—' %></td>
            <td><%= o.license_plate_raw || (o.car_id ? '—' : 'не указано') %></td>
            <td><%= o.car_make || '—' %></td>
            <td><%= o.car_model || '—' %></td>
            <td><%= o.client_name || '—' %></td>
            <td class="muted"><%= o.client_phone || '—' %></td>
            <td><span class="status-badge status-<%= o.status %>"><%= (statusLabels && statusLabels[o.status]) || o.status %></span></td>
            <% if (typeof showMoney !== 'undefined' && showMoney) { %>
            <td class="num"><%= Number(o.total_price).toFixed(2) %> ₽</td>
            <td class="num">
              <% if (o.due_amount > 0) { %>
                <span class="due-badge"><%= Number(o.due_amount).toFixed(2) %> ₽</span>
              <% } else { %>
                <span class="muted">0</span>
              <% } %>
            </td>
            <% } %>
            <% if (typeof can !== 'undefined' && can('orders:mutate')) { %>
            <td>
              <form method="post" action="/orders/<%= o.id %>?_method=DELETE" onclick="event.stopPropagation()" onsubmit="return confirm('Удалить заказ #<%= o.id %>?');">
    <%- include('../partials/csrf-field') %>
                <button type="submit" class="btn btn-sm btn-delete" title="Удалить">×</button>
              </form>
            </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/layout-bottom') %>
