<%- include('../partials/layout-top', { title: 'Заказ #' + order.id, user, category: 'orders' }) %>
<section class="card">
  <p><strong>Клиент:</strong> <a href="/clients/<%= order.client_id %>"><%= order.client_name %></a> (<%= order.client_phone %>)</p>
  <p><strong>Авто:</strong> <%= [order.make, order.model].filter(Boolean).join(' ') %> <%= order.license_plate_raw || '' %> <%= order.vin ? 'VIN ' + order.vin : '' %></p>
  <p><strong>Тип работ:</strong> <%= order.work_type || '—' %> · <strong>Статус:</strong> <%= order.status %></p>
  <p style="display:flex; gap:8px; flex-wrap:wrap;">
    <a class="btn btn-secondary btn-sm" href="/orders/<%= order.id %>/print" target="_blank">Заказ-наряд</a>
    <a class="btn btn-secondary btn-sm" href="/orders/<%= order.id %>/act-acceptance" target="_blank">Акт приёма-передачи</a>
    <a class="btn btn-secondary btn-sm" href="/orders/<%= order.id %>/act-completion" target="_blank">Акт выполненных работ</a>
  </p>

  <form method="post" action="/orders/<%= order.id %>?_method=PUT" style="margin-top:12px;">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:8px;">
      <label>Тип работ
        <select name="work_type" <%= order.status === 'completed' ? 'disabled' : '' %>>
          <% ['Мойка','Электрика','Продажа'].forEach(t => { %>
            <option value="<%= t %>" <%= order.work_type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </label>
      <label>Статус
        <select name="status" <%= order.status === 'completed' ? 'disabled' : '' %>>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>
      <label>Скидка тип
        <select name="discount_type">
          <option value="none" <%= order.discount_type === 'none' ? 'selected' : '' %>>нет</option>
          <option value="amount" <%= order.discount_type === 'amount' ? 'selected' : '' %>>сумма</option>
          <option value="percent" <%= order.discount_type === 'percent' ? 'selected' : '' %>>%</option>
        </select>
      </label>
      <label>Значение <input name="discount_value" value="<%= order.discount_value %>" /></label>
      <label>Область
        <select name="discount_scope">
          <option value="order_total" <%= order.discount_scope === 'order_total' ? 'selected' : '' %>>весь заказ</option>
          <option value="works_only" <%= order.discount_scope === 'works_only' ? 'selected' : '' %>>только работы</option>
          <option value="products_only" <%= order.discount_scope === 'products_only' ? 'selected' : '' %>>только товары</option>
        </select>
      </label>
      <label>Дата
        <input type="date" name="scheduled_date" value="<%= (order.scheduled_date || '').slice(0,10) %>" <%= order.status === 'completed' ? 'disabled' : '' %> />
      </label>
      <label>Сотрудник
        <select name="assigned_user_id" <%= order.status === 'completed' ? 'disabled' : '' %>>
          <option value="">— не назначен —</option>
          <% (masters || []).forEach(m => { %>
            <option value="<%= m.id %>" <%= Number(order.assigned_user_id) === m.id ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Начало
        <input type="time" name="start_time" value="<%= (order.start_time || '').slice(0,5) %>" <%= order.status === 'completed' ? 'disabled' : '' %> />
      </label>
      <label>Окончание
        <input type="time" name="end_time" value="<%= (order.end_time || '').slice(0,5) %>" <%= order.status === 'completed' ? 'disabled' : '' %> />
      </label>
    </div>
    <label>Комментарий <textarea name="notes" rows="2"><%= order.notes || '' %></textarea></label>
    <% if (order.status !== 'completed') { %>
      <button type="submit" class="btn-primary">Сохранить шапку</button>
    <% } %>
  </form>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Работы</h2>
  <table>
    <thead><tr><th>Название</th><th>Мастер</th><th>Qty</th><th>Цена</th><th>Сумма</th><th></th></tr></thead>
    <tbody>
      <% works.forEach(l => { %>
        <tr>
          <td><%= l.name %></td>
          <td><%= l.master_id || '—' %></td>
          <td><%= l.quantity %></td>
          <td><%= Number(l.unit_price).toFixed(2) %></td>
          <td><%= Number(l.total).toFixed(2) %></td>
          <td>
            <% if (order.status !== 'completed') { %>
            <form method="post" action="/orders/lines/<%= l.id %>?_method=DELETE" style="display:inline;">
              <button type="submit">×</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (order.status !== 'completed') { %>
  <form method="post" action="/orders/<%= order.id %>/lines" style="margin-top:12px; display:grid; gap:8px;">
    <input type="hidden" name="line_type" value="work" />
    <label>Из каталога
      <select name="catalog_item_id">
        <option value="">— вручную —</option>
        <% catalogWorks.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.name %> (<%= c.default_price %>)</option>
        <% }) %>
      </select>
    </label>
    <label>Название <input name="name" /></label>
    <label>Кол-во <input name="quantity" value="1" /></label>
    <label>Цена <input name="unit_price" /></label>
    <label>Мастер ID <input name="master_id" /></label>
    <button type="submit">Добавить работу</button>
  </form>
  <% } %>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Товары</h2>
  <table>
    <thead><tr><th>Название</th><th>Qty</th><th>Цена</th><th>Закупка</th><th>Сумма</th><th></th></tr></thead>
    <tbody>
      <% products.forEach(l => { %>
        <tr>
          <td><%= l.name %></td>
          <td><%= l.quantity %></td>
          <td><%= Number(l.unit_price).toFixed(2) %></td>
          <td><%= Number(l.cost_price || 0).toFixed(2) %></td>
          <td><%= Number(l.total).toFixed(2) %></td>
          <td>
            <% if (order.status !== 'completed') { %>
            <form method="post" action="/orders/lines/<%= l.id %>?_method=DELETE" style="display:inline;">
              <button type="submit">×</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (order.status !== 'completed') { %>
  <form method="post" action="/orders/<%= order.id %>/lines" style="margin-top:12px;">
    <input type="hidden" name="line_type" value="product" />
    <label>Из каталога
      <select name="catalog_item_id">
        <option value="">— вручную —</option>
        <% catalogProducts.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Название <input name="name" /></label>
    <label>Кол-во <input name="quantity" value="1" /></label>
    <label>Цена продажи <input name="unit_price" /></label>
    <label>Закупка (расходник) <input name="cost_price" value="0" /></label>
    <button type="submit">Добавить товар</button>
  </form>
  <% } %>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Фото работ</h2>
  <% if (photos && photos.length) { %>
  <div style="display:flex; gap:10px; flex-wrap:wrap;">
    <% photos.forEach(p => { %>
      <div style="width:140px;">
        <a href="/orders/<%= order.id %>/photos/<%= p.id %>/file" target="_blank">
          <img src="/orders/<%= order.id %>/photos/<%= p.id %>/file" alt="<%= p.original_name || 'фото' %>"
               style="width:140px; height:105px; object-fit:cover; border-radius:8px; border:1px solid var(--border-subtle,#e5e7eb);" />
        </a>
        <form method="post" action="/orders/<%= order.id %>/photos/<%= p.id %>?_method=DELETE" style="margin-top:4px;">
          <button type="submit" class="btn btn-sm">Удалить</button>
        </form>
      </div>
    <% }) %>
  </div>
  <% } else { %>
    <p class="muted">Фото пока нет.</p>
  <% } %>
  <form method="post" action="/orders/<%= order.id %>/photos" enctype="multipart/form-data" style="margin-top:12px;">
    <input type="file" name="photo" accept="image/*" multiple />
    <button type="submit" class="btn btn-primary btn-sm">Загрузить</button>
  </form>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Итоги</h2>
  <p>Работы: <strong><%= Number(order.subtotal_works).toFixed(2) %></strong> ₽</p>
  <p>Товары: <strong><%= Number(order.subtotal_products).toFixed(2) %></strong> ₽</p>
  <p>Скидка: <strong><%= Number(order.discount_amount).toFixed(2) %></strong> ₽</p>
  <% if (order.tax_enabled) { %>
    <p>Налог: <strong><%= Number(order.tax_amount).toFixed(2) %></strong> ₽</p>
  <% } %>
  <p>Итого: <strong><%= Number(order.total_price).toFixed(2) %></strong> ₽</p>
  <p>Оплачено: <strong><%= Number(paid_amount).toFixed(2) %></strong> ₽ · Долг: <strong><%= Number(due_amount).toFixed(2) %></strong> ₽</p>
</section>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Оплаты</h2>
  <ul>
    <% payments.forEach(p => { %>
      <li><%= p.paid_at %> — <%= p.kind %> <%= Number(p.amount).toFixed(2) %> ₽ (<%= p.method %>)</li>
    <% }) %>
  </ul>
  <% if (order.status !== 'cancelled' && due_amount > 0) { %>
  <form method="post" action="/orders/<%= order.id %>/payments">
    <label>Сумма <input name="amount" required /></label>
    <label>Способ
      <select name="method">
        <option value="cash">cash</option>
        <option value="card">card</option>
        <option value="transfer">transfer</option>
        <option value="other">other</option>
      </select>
    </label>
    <button type="submit">Принять оплату</button>
  </form>
  <% } %>
</section>
<%- include('../partials/layout-bottom') %>
