<%- include('../partials/layout-top', { title: 'Заказ #' + order.id, user, category: 'orders' }) %>

<% if (typeof scheduleError !== 'undefined' && scheduleError) { %><div class="error" style="margin-bottom:12px;"><%= scheduleError %></div><% } %>
<% if (typeof workTypeError !== 'undefined' && workTypeError) { %><div class="error" style="margin-bottom:12px;"><%= workTypeError %></div><% } %>
<% if (typeof carError !== 'undefined' && carError) { %><div class="error" style="margin-bottom:12px;"><%= carError %></div><% } %>

<% if (typeof mileageError !== 'undefined' && mileageError) { %><div class="error" style="margin-bottom:12px;">Укажите пробег целым числом км (или оставьте пустым).</div><% } %>

<% const masterView = typeof isMasterView !== 'undefined' && isMasterView; %>
<% const hideLineMoney = masterView; %>
<% const canEditLines = order.status !== 'cancelled' && order.status !== 'completed' && !hideLineMoney; %>
<% function orderTimeInput(v) { if (v == null || v === '') return ''; const s = String(v).trim(); return s.length >= 5 ? s.slice(0, 5) : s; } %>

<section class="card order-summary-card">
  <div class="order-title-row">
    <h1 class="order-title">#<%= order.id %> · <%= [order.make, order.model].filter(Boolean).join(' ') || (order.car_id ? 'Авто' : 'Авто не указано') %></h1>
    <% if (order.car_id) { %>
      <% if (typeof canEditMileage !== 'undefined' && canEditMileage) { %>
      <form method="post" action="/orders/<%= order.id %>/mileage" class="order-mileage-form">
        <label class="order-mileage-form__label">Пробег, км
          <input class="order-mileage-form__input" name="mileage" type="number" min="0" step="1" inputmode="numeric" placeholder="—" value="<%= order.mileage != null && order.mileage !== '' ? order.mileage : '' %>" />
        </label>
        <button type="submit" class="btn btn-primary btn-sm" title="Сохранить пробег">✓</button>
      </form>
      <% } else if (order.mileage != null && order.mileage !== '') { %>
      <span class="order-mileage-readonly muted">Пробег: <%= Number(order.mileage).toLocaleString('ru-RU') %> км</span>
      <% } %>
    <% } %>
  </div>
  <% if (order.client_name) { %>
  <p class="order-subtitle"><%= order.client_name %><% if (order.client_phone) { %> · <%= order.client_phone %><% } %></p>
  <% } else if (!order.car_id) { %>
  <p class="order-subtitle muted">Клиент и авто будут указаны при приёмке</p>
  <% } %>
  <% if (order.license_plate_raw) { %><p class="muted"><%= order.license_plate_raw %></p><% } %>
  <% if (order.notes) { %>
  <p class="order-intake-note"><span class="muted">При записи:</span> <%= order.notes %></p>
  <% } %>
  <% if (order.scheduled_date || order.start_time || order.end_time) { %>
  <p class="order-schedule-strip muted">
    <% if (order.scheduled_date) { %><%= String(order.scheduled_date).slice(0, 10) %><% } %>
    <% if (order.start_time) { %> · <%= orderTimeInput(order.start_time) %><% if (order.end_time) { %>–<%= orderTimeInput(order.end_time) %><% } %><% } else if (!masterView && order.status !== 'completed' && order.status !== 'cancelled') { %>
    · <span class="order-schedule-missing">время не указано</span>
    <% } %>
  </p>
  <% } %>

  <% if (typeof due_amount !== 'undefined' && due_amount > 0 && order.status !== 'cancelled' && !masterView) { %>
  <div class="order-due-alert" role="status">
    <strong>Долг по заказу: <%= Number(due_amount).toLocaleString('ru-RU') %> ₽</strong>
    <span class="muted"> · оплачено <%= Number(paid_amount).toFixed(0) %> из <%= Number(order.total_price).toFixed(0) %> ₽</span>
  </div>
  <% } %>

  <% var canChangeStatus = typeof canChangeOrderStatus !== 'undefined' && canChangeOrderStatus; %>
  <% var statusChipOptions = typeof statusOptions !== 'undefined' ? statusOptions : ['scheduled','in_progress','ready','completed']; %>
  <% if (canChangeStatus) { %>
  <div class="status-chips" role="group" aria-label="Статус заказа">
    <% statusChipOptions.forEach(function(s) { %>
      <form method="post" action="/orders/<%= order.id %>/status" class="status-chip-form">
        <input type="hidden" name="status" value="<%= s %>" />
        <button type="submit" class="status-chip <%= order.status === s ? 'active' : '' %>"><%= statusLabel(s) %></button>
      </form>
    <% }) %>
  </div>
  <% if (canChangeStatus && (order.status === 'completed' || order.status === 'cancelled')) { %>
  <p class="muted" style="margin:8px 0 0;font-size:0.8rem;">Владелец/админ: можно вернуть заказ в работу или сменить статус.</p>
  <% } %>
  <% } else { %>
  <p class="order-status-display">
    <span class="status-badge status-<%= order.status %>"><%= statusLabel(order.status) %></span>
  </p>
  <% } %>

  <% if (typeof isOwnerView !== 'undefined' && isOwnerView && economics) { %>
  <div class="economics-strip <%= economics.is_estimate ? 'is-estimate' : '' %>">
    <span>Итого <strong><%= Number(economics.revenue).toFixed(0) %> ₽</strong></span>
    <span>Расходн. <strong><%= Number(economics.materials).toFixed(0) %> ₽</strong></span>
    <span>ЗП <strong><%= economics.is_estimate ? '≈' : '' %><%= Number(economics.payroll).toFixed(0) %> ₽</strong></span>
    <span>Прибыль <strong><%= Number(economics.profit).toFixed(0) %> ₽</strong></span>
  </div>
  <% if (economics.hints && economics.hints.length) { %>
  <ul class="economics-hints">
    <% economics.hints.forEach(h => { %><li><%= h %></li><% }) %>
  </ul>
  <% } %>
  <% } %>

  <div class="order-doc-links">
    <details class="print-menu">
      <summary class="btn btn-secondary btn-sm print-menu__toggle">Печать</summary>
      <div class="print-menu__panel" role="menu">
        <a class="print-menu__item" role="menuitem" href="/orders/<%= order.id %>/print" target="_blank" rel="noopener">Заказ-наряд</a>
        <a class="print-menu__item" role="menuitem" href="/orders/<%= order.id %>/act-acceptance" target="_blank" rel="noopener">Акт приёма-передачи</a>
        <a class="print-menu__item" role="menuitem" href="/orders/<%= order.id %>/act-completion" target="_blank" rel="noopener">Акт выполненных работ</a>
      </div>
    </details>
    <% if (typeof can !== 'undefined' && can('orders:mutate')) { %>
    <form method="post" action="/orders/<%= order.id %>?_method=DELETE" class="order-delete-form" onsubmit="return confirm('Удалить заказ #<%= order.id %> безвозвратно?');">
      <button type="submit" class="btn btn-sm btn-delete">Удалить заказ</button>
    </form>
    <% } %>
  </div>
</section>

<% if (!masterView && !order.car_id) { %>
<details class="order-accordion card" open>
  <summary class="order-accordion-summary">Авто и клиент</summary>
  <div class="order-accordion-body">
    <form method="post" action="/orders/<%= order.id %>/car" class="order-car-assign-form" data-vehicle-autocomplete>
      <label style="display:block;margin-bottom:8px;">Автомобиль из базы
        <select name="car_id">
          <option value="">— новый по данным ниже —</option>
          <% (cars || []).forEach(c => { %>
            <option value="<%= c.id %>"><%= c.license_plate_raw || 'б/н' %> — <%= [c.make, c.model].filter(Boolean).join(' ') %> · <%= c.full_name %></option>
          <% }) %>
        </select>
      </label>
      <div class="order-form-grid">
        <input type="hidden" name="vehicle_model_id" value="" />
        <label>Госномер <input name="new_plate" class="plate-search-input" data-plate-input placeholder="А123ВС777" /></label>
        <label>Марка <input name="new_make" data-ac-mark autocomplete="off" /></label>
        <label>Модель <input name="new_model" data-ac-model autocomplete="off" /></label>
        <label>ФИО владельца <input name="new_owner_name" /></label>
        <label>Телефон <input name="new_owner_phone" inputmode="tel" placeholder="+7…" /></label>
      </div>
      <button type="submit" class="btn btn-primary btn-sm" style="margin-top:8px;">Привязать авто</button>
    </form>
  </div>
</details>
<% } %>

<% if (!masterView) { %>
<details class="order-accordion card" open>
  <summary class="order-accordion-summary">Детали заказа</summary>
  <div class="order-accordion-body">
    <% if (!order.start_time && order.status !== 'completed' && order.status !== 'cancelled') { %>
    <p class="error" style="margin-top:0;">Время начала не указано — задайте ниже и нажмите «Сохранить детали».</p>
    <% } %>
    <form method="post" action="/orders/<%= order.id %>?_method=PUT" class="order-header-form">
      <div class="order-form-grid">
        <% if (order.status !== 'completed') { %>
        <%- include('../partials/work-type-checkboxes', { workTypes, selectedWorkTypes: typeof selectedWorkTypes !== 'undefined' ? selectedWorkTypes : [], workTypeRequired: true }) %>
        <% } else { %>
        <label>Тип работ <input value="<%= order.work_type || '—' %>" disabled /></label>
        <% } %>
        <label>Дата <input type="date" name="scheduled_date" value="<%= (order.scheduled_date || '').slice(0,10) %>" <%= order.status === 'completed' ? 'disabled' : '' %> /></label>
        <label>Начало <input type="time" name="start_time" value="<%= orderTimeInput(order.start_time) %>" <%= order.status === 'completed' ? 'disabled' : '' %> /></label>
        <label>Окончание <input type="time" name="end_time" value="<%= orderTimeInput(order.end_time) %>" <%= order.status === 'completed' ? 'disabled' : '' %> /></label>
        <label>Сотрудник
          <select name="assigned_user_id" <%= order.status === 'completed' ? 'disabled' : '' %>>
            <option value="">—</option>
            <% (masters || []).forEach(m => { %>
              <option value="<%= m.id %>" <%= Number(order.assigned_user_id) === m.id ? 'selected' : '' %><%= m.absent ? ' disabled' : '' %>><%= m.name %><% if (m.absent) { %> (отсутствует)<% } %></option>
            <% }) %>
          </select>
        </label>
        <label>Скидка
          <select name="discount_type" <%= order.status === 'completed' ? 'disabled' : '' %>>
            <option value="none" <%= order.discount_type === 'none' ? 'selected' : '' %>>нет</option>
            <option value="amount" <%= order.discount_type === 'amount' ? 'selected' : '' %>>сумма</option>
            <option value="percent" <%= order.discount_type === 'percent' ? 'selected' : '' %>>%</option>
          </select>
        </label>
        <label>Значение <input name="discount_value" value="<%= order.discount_value %>" <%= order.status === 'completed' ? 'disabled' : '' %> /></label>
      </div>
      <label>Комментарий при записи <textarea name="notes" rows="2" placeholder="Что сказал клиент при записи" <%= order.status === 'completed' ? 'disabled' : '' %>><%= order.notes || '' %></textarea></label>
      <% if (order.status !== 'completed') { %>
        <button type="submit" class="btn-secondary">Сохранить детали</button>
      <% } %>
    </form>
  </div>
</details>
<% } %>

<details class="order-accordion card" open>
  <summary class="order-accordion-summary">Работы<% if (masterView) { %> <span class="muted">(ваши)</span><% } %></summary>
  <div class="order-accordion-body">
    <div class="work-lines-table-wrap table-scroll">
      <% works.forEach(l => { %>
        <% if (canEditLines) { %>
          <form id="work-line-form-<%= l.id %>" method="post" action="/orders/lines/<%= l.id %>?_method=PUT"></form>
        <% } %>
      <% }) %>
      <table class="data-table-compact work-lines-table">
        <thead>
          <tr>
            <th>Работа</th>
            <% if (!hideLineMoney) { %><th>Кол-во</th><th>Цена</th><% } %>
            <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %><th>Расходник</th><% } %>
            <th>Мастер</th>
            <% if (!hideLineMoney) { %><th>Сумма</th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% works.forEach(l => { %>
            <tr>
              <td class="work-line-name-cell">
                <strong><%= l.name %></strong>
                <% if (l.notes) { %><div class="muted table-sub" style="white-space:pre-line;"><%= l.notes %></div><% } %>
                <% if (l.vehicle_tier && Number(l.vehicle_tier) > 1) { %><div class="muted table-sub">Кат. авто: <%= l.vehicle_tier %></div><% } %>
                <% if (!hideLineMoney && masterView && l.payroll_estimate != null) { %>
                  <div class="muted table-sub">≈ ЗП <%= Number(l.payroll_estimate).toFixed(0) %> ₽</div>
                <% } %>
              </td>
              <% if (canEditLines) { %>
                <% if (!hideLineMoney) { %>
                <td><input class="table-input" form="work-line-form-<%= l.id %>" name="quantity" value="<%= l.quantity %>" inputmode="decimal" /></td>
                <td><input class="table-input" form="work-line-form-<%= l.id %>" name="unit_price" value="<%= l.unit_price %>" inputmode="decimal" /></td>
                <% } %>
                <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %>
                  <td><input class="table-input" form="work-line-form-<%= l.id %>" name="material_cost" value="<%= l.cost_price || 0 %>" inputmode="decimal" /></td>
                <% } %>
                <td>
                  <select class="table-input" form="work-line-form-<%= l.id %>" name="master_id">
                    <option value="">—</option>
                    <% (masters || []).forEach(m => { %>
                      <option value="<%= m.id %>" <%= Number(l.master_id) === m.id ? 'selected' : '' %>><%= m.name %></option>
                    <% }) %>
                  </select>
                </td>
              <% } else { %>
                <% if (!hideLineMoney) { %>
                <td><%= l.quantity %></td>
                <td><%= Number(l.unit_price).toFixed(2) %></td>
                <% } %>
                <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %><td><%= Number(l.cost_price || 0).toFixed(2) %></td><% } %>
                <td><%= l.master_name || '—' %></td>
              <% } %>
              <% if (!hideLineMoney) { %><td><strong><%= Number(l.total).toFixed(2) %> ₽</strong></td><% } %>
              <td class="table-actions-cell">
                <% if (canEditLines) { %>
                  <div class="table-row-actions">
                    <button type="submit" form="work-line-form-<%= l.id %>" class="btn btn-primary btn-sm" title="Сохранить">✓</button>
                    <form method="post" action="/orders/lines/<%= l.id %>?_method=DELETE" class="line-delete-form">
                      <button type="submit" class="btn btn-sm btn-delete" title="Удалить">×</button>
                    </form>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (!works.length) { %>
            <tr><td colspan="<%= (hideLineMoney ? 2 : 4) + (typeof isOwnerView !== 'undefined' && isOwnerView ? 1 : 0) + 1 %>" class="muted">Работ пока нет.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (canEditLines) { %>
    <form method="post" action="/orders/<%= order.id %>/lines" class="order-add-line-form" id="form-add-work" data-catalog-ac data-work-category="<%= typeof catalogWorkCategory !== 'undefined' ? catalogWorkCategory : (order.work_type || '') %>">
      <input type="hidden" name="line_type" value="work" />
      <input type="hidden" name="catalog_item_id" value="" />
      <label class="order-add-line-field order-add-line-field--wide">Услуга <input name="name" placeholder="Начните вводить — подсказки из прайса" autocomplete="off" /></label>
      <div class="order-add-line-fields-row">
        <label class="order-add-line-field">Кол-во <input name="quantity" value="1" inputmode="decimal" /></label>
        <label class="order-add-line-field">Цена <input name="unit_price" inputmode="decimal" /></label>
        <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %>
        <label class="order-add-line-field">Расходник <input name="material_cost" value="0" inputmode="decimal" placeholder="из прайса, можно изменить" /></label>
        <% } %>
      </div>
      <div class="master-checkboxes master-checkboxes--compact">
        <span class="master-checkboxes__label">Мастера:</span>
        <div class="master-checkboxes-list">
          <% (masters || []).forEach(m => { %>
            <label class="master-checkbox-item">
              <input type="checkbox" name="master_ids[]" value="<%= m.id %>" />
              <span><%= m.name %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Добавить работу</button>
    </form>
    <% } %>
  </div>
</details>

<details class="order-accordion card">
  <summary class="order-accordion-summary">Товары</summary>
  <div class="order-accordion-body">
    <div class="table-scroll">
      <table class="order-lines-table">
        <thead>
          <tr>
            <th>Название</th>
            <th>Сумма</th>
            <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %><th>Закупка</th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(l => { %>
            <tr>
              <td data-label="Название"><%= l.name %></td>
              <td data-label="Сумма"><%= Number(l.total).toFixed(2) %></td>
              <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %>
              <td data-label="Закупка"><%= Number(l.cost_price || 0).toFixed(2) %></td>
              <% } %>
              <td>
                <% if (canEditLines) { %>
                <form method="post" action="/orders/lines/<%= l.id %>?_method=DELETE" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-delete btn-line-delete" title="Удалить">×</button>
                </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (canEditLines) { %>
    <form method="post" action="/orders/<%= order.id %>/lines" class="order-add-line-form" data-catalog-ac data-work-category="">
      <input type="hidden" name="line_type" value="product" />
      <input type="hidden" name="catalog_item_id" value="" />
      <label class="order-add-line-field order-add-line-field--wide">Товар <input name="name" placeholder="Начните вводить — подсказки из прайса" autocomplete="off" /></label>
      <div class="order-add-line-fields-row">
        <label class="order-add-line-field">Кол-во <input name="quantity" value="1" inputmode="decimal" /></label>
        <label class="order-add-line-field">Цена <input name="unit_price" inputmode="decimal" /></label>
        <% if (typeof isOwnerView !== 'undefined' && isOwnerView) { %>
        <label class="order-add-line-field">Закупка <input name="cost_price" value="0" inputmode="decimal" /></label>
        <% } else { %>
        <input type="hidden" name="cost_price" value="0" />
        <% } %>
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Добавить товар</button>
    </form>
    <% } %>
  </div>
</details>

<% if (typeof canAnnotateOrder !== 'undefined' && canAnnotateOrder) { %>
<details class="order-accordion card">
  <summary class="order-accordion-summary">Комментарий и фото</summary>
  <div class="order-accordion-body">
    <form method="post" action="/orders/<%= order.id %>/notes" class="order-master-notes-form">
      <label>Комментарий по работе
        <textarea name="annotation_notes" rows="3" placeholder="Заметки мастера, дефекты, что сделано…"><%= order.annotation_notes || '' %></textarea>
      </label>
      <button type="submit" class="btn btn-primary btn-sm">Сохранить комментарий</button>
    </form>
    <% if (photos && photos.length) { %>
    <div class="order-photos-grid">
      <% photos.forEach(p => { %>
        <a href="/orders/<%= order.id %>/photos/<%= p.id %>/file" target="_blank">
          <img src="/orders/<%= order.id %>/photos/<%= p.id %>/file" alt="" class="order-photo-thumb" />
        </a>
      <% }) %>
    </div>
    <% } %>
    <form method="post" action="/orders/<%= order.id %>/photos" enctype="multipart/form-data" class="order-photo-upload">
      <input type="file" name="photo" accept="image/*" multiple />
      <button type="submit" class="btn btn-sm">Загрузить фото</button>
    </form>
  </div>
</details>
<% } else if (!masterView) { %>
<details class="order-accordion card">
  <summary class="order-accordion-summary">Фото</summary>
  <div class="order-accordion-body">
    <% if (order.annotation_notes) { %>
    <p class="order-annotation-note" style="white-space:pre-line;"><%= order.annotation_notes %></p>
    <% } %>
    <% if (photos && photos.length) { %>
    <div class="order-photos-grid">
      <% photos.forEach(p => { %>
        <a href="/orders/<%= order.id %>/photos/<%= p.id %>/file" target="_blank">
          <img src="/orders/<%= order.id %>/photos/<%= p.id %>/file" alt="" class="order-photo-thumb" />
        </a>
      <% }) %>
    </div>
    <% } %>
    <% if (canEditLines) { %>
    <form method="post" action="/orders/<%= order.id %>/photos" enctype="multipart/form-data" class="order-photo-upload">
      <input type="file" name="photo" accept="image/*" multiple />
      <button type="submit" class="btn btn-sm">Загрузить</button>
    </form>
    <% } %>
  </div>
</details>
<% } %>

<% if (!masterView) { %>
<details class="order-accordion card">
  <summary class="order-accordion-summary">Оплата · долг <%= Number(due_amount).toFixed(0) %> ₽</summary>
  <div class="order-accordion-body">
    <p>Итого: <strong><%= Number(order.total_price).toFixed(2) %> ₽</strong> · Оплачено: <strong><%= Number(paid_amount).toFixed(2) %> ₽</strong></p>
    <ul class="payment-list">
      <% payments.forEach(p => { %>
        <li><%= p.paid_at %> — <%= Number(p.amount).toFixed(2) %> ₽ (<%= p.method %>)</li>
      <% }) %>
    </ul>
    <% if (canEditLines && order.status !== 'cancelled' && due_amount > 0) { %>
    <form method="post" action="/orders/<%= order.id %>/payments" class="order-payment-form" id="form-payment">
      <label>Сумма <input name="amount" value="<%= Number(due_amount).toFixed(2) %>" required inputmode="decimal" /></label>
      <label>Способ
        <select name="method">
          <option value="cash">Наличные</option>
          <option value="card">Карта</option>
          <option value="transfer">Перевод</option>
          <option value="other">Другое</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary btn-sm">Принять оплату</button>
    </form>
    <% } %>
  </div>
</details>
<% } %>

<%- include('../partials/layout-bottom', { extraScripts: ['/js/catalog-autocomplete.js', '/js/work-type-picker.js', '/js/vehicle-autocomplete.js'] }) %>
