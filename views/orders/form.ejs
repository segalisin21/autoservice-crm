<%- include('../partials/layout-top', { title: 'Новый заказ', user, category: 'orders' }) %>

<section class="card">
  <h2 style="margin:0 0 8px 0; font-size:16px;">Поиск авто по госномеру</h2>
  <form method="get" action="/orders/new" style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
    <label style="flex:1; min-width:200px;">Госномер
      <input name="plate" value="<%= typeof plateQuery !== 'undefined' ? plateQuery : '' %>" placeholder="А123ВС777" autocomplete="off" />
    </label>
    <button type="submit" class="btn btn-primary btn-sm">Найти</button>
  </form>
  <% if (typeof plateMatches !== 'undefined' && plateMatches && plateMatches.length) { %>
    <table style="margin-top:12px;">
      <thead><tr><th>Госномер</th><th>Авто</th><th>Владелец</th><th></th></tr></thead>
      <tbody>
        <% plateMatches.forEach(m => { %>
          <tr>
            <td><%= m.license_plate_raw || '' %></td>
            <td><%= [m.make, m.model, m.year].filter(Boolean).join(' ') %></td>
            <td><%= m.client_name %> · <%= m.client_phone %></td>
            <td><a class="btn btn-secondary btn-sm" href="/orders/new?car_id=<%= m.id %>">Выбрать</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else if (typeof plateQuery !== 'undefined' && plateQuery) { %>
    <p class="muted" style="margin-top:8px;">Не найдено. Заполните данные нового авто и владельца ниже.</p>
  <% } %>
</section>

<section class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/orders">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;">
      <label>Дата
        <input type="date" name="scheduled_date" value="<%= order.scheduled_date || '' %>" required />
      </label>
      <label>Сотрудник
        <select name="assigned_user_id">
          <option value="">— не назначен —</option>
          <% (masters || []).forEach(m => { %>
            <option value="<%= m.id %>" <%= String(order.assigned_user_id) === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Начало
        <input type="time" name="start_time" value="<%= order.start_time || '' %>" />
      </label>
      <label>Окончание
        <input type="time" name="end_time" value="<%= order.end_time || '' %>" />
      </label>
    </div>
    <label>Тип работ
      <select name="work_type" required>
        <% workTypes.forEach(t => { %>
          <option value="<%= t %>" <%= (order.work_type || 'Электрика') === t ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label>Автомобиль из базы
      <select name="car_id">
        <option value="">— новый авто (заполните ниже) —</option>
        <% cars.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(order.car_id) === String(c.id) ? 'selected' : '' %>>
            <%= c.license_plate_raw || '' %> — <%= [c.make, c.model].filter(Boolean).join(' ') %> · <%= c.full_name %>
          </option>
        <% }) %>
      </select>
    </label>

    <fieldset style="margin-top:12px; border:1px solid var(--border-subtle,#e5e7eb); border-radius:8px; padding:12px;">
      <legend style="font-size:13px; color:var(--text-muted,#6b7280);">Или новый авто + владелец</legend>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px;">
        <label>Госномер <input name="new_plate" value="<%= order.new_plate || '' %>" /></label>
        <label>Марка <input name="new_make" value="<%= order.new_make || '' %>" /></label>
        <label>Модель <input name="new_model" value="<%= order.new_model || '' %>" /></label>
        <label>Год выпуска <input name="new_year" value="<%= order.new_year || '' %>" /></label>
        <label>VIN <input name="new_vin" value="<%= order.new_vin || '' %>" /></label>
        <label>ФИО владельца <input name="new_owner_name" value="<%= order.new_owner_name || '' %>" /></label>
        <label>Телефон владельца <input name="new_owner_phone" value="<%= order.new_owner_phone || '' %>" /></label>
      </div>
    </fieldset>

    <label>Комментарий <textarea name="notes" rows="2"><%= order.notes || '' %></textarea></label>
    <button type="submit" class="btn btn-primary" style="margin-top:12px;">Создать</button>
  </form>
</section>
<%- include('../partials/layout-bottom') %>
