<%- include('../partials/layout-top', { title: 'Новый заказ', user, category: 'orders' }) %>

<section class="card plate-search-card">
  <h2 class="card-title-sm">Поиск по госномеру</h2>
  <p class="muted" style="margin-top:0;">Введите номер — если авто уже в базе, выберите его. Иначе создайте клиента и авто ниже.</p>
  <form method="get" action="/orders/new" class="plate-search-form">
    <input name="plate" class="plate-search-input" data-plate-input value="<%= typeof plateQuery !== 'undefined' ? plateQuery : '' %>" placeholder="А123ВС777" autocomplete="off" autofocus inputmode="text" />
    <button type="submit" class="btn btn-primary">Найти</button>
  </form>

  <% if (typeof plateMatches !== 'undefined' && plateMatches && plateMatches.length) { %>
    <div class="plate-results">
      <% plateMatches.forEach(m => { %>
        <a href="/orders/new?car_id=<%= m.id %>" class="plate-result-card">
          <div class="prc-plate"><%= m.license_plate_raw || '—' %></div>
          <div class="prc-car"><%= [m.make, m.model, m.year].filter(Boolean).join(' ') %></div>
          <div class="prc-owner muted"><%= m.client_name %> · <%= m.client_phone %></div>
          <span class="prc-action">Выбрать →</span>
        </a>
      <% }) %>
    </div>
  <% } else if (typeof plateQuery !== 'undefined' && plateQuery) { %>
    <p class="plate-not-found">Не найдено. Заполните блок «Новый авто + владелец» — госномер подставится из поиска.</p>
  <% } %>
</section>

<section class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/orders" class="new-order-form" data-vehicle-autocomplete>
    <div class="order-form-grid">
      <label>Дата
        <input type="date" name="scheduled_date" value="<%= order.scheduled_date || '' %>" required />
      </label>
      <label>Сотрудник
        <select name="assigned_user_id">
          <option value="">— не назначен —</option>
          <% (masters || []).forEach(m => { %>
            <option value="<%= m.id %>" <%= String(order.assigned_user_id) === String(m.id) ? 'selected' : '' %><%= m.absent ? ' disabled' : '' %>><%= m.name %><% if (m.absent) { %> (отсутствует)<% } %></option>
          <% }) %>
        </select>
      </label>
      <label>Начало <input type="time" name="start_time" value="<%= order.start_time || '' %>" /></label>
      <label>Окончание <input type="time" name="end_time" value="<%= order.end_time || '' %>" /></label>
    </div>
    <label>Тип работ</label>
    <%- include('../partials/work-type-checkboxes', { workTypes, selectedWorkTypes: typeof selectedWorkTypes !== 'undefined' ? selectedWorkTypes : ['Электрика'] }) %>

    <% if (typeof plateMatches !== 'undefined' && plateMatches && plateMatches.length && order.car_id) { %>
      <% const selected = plateMatches.find(m => String(m.id) === String(order.car_id)); %>
      <% if (selected) { %>
        <div class="selected-car-banner">
          <strong><%= selected.license_plate_raw %></strong> — <%= [selected.make, selected.model].filter(Boolean).join(' ') %>
          · <%= selected.client_name %>
        </div>
        <input type="hidden" name="car_id" value="<%= order.car_id %>" />
      <% } %>
    <% } else { %>
    <label>Автомобиль из базы
      <select name="car_id">
        <option value="">— новый авто (заполните ниже) —</option>
        <% cars.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(order.car_id) === String(c.id) ? 'selected' : '' %>>
            <%= c.license_plate_raw || 'б/н' %> — <%= [c.make, c.model].filter(Boolean).join(' ') %> · <%= c.full_name %>
          </option>
        <% }) %>
      </select>
    </label>
    <% } %>

    <details class="order-accordion-inline" <%= (typeof plateQuery !== 'undefined' && plateQuery && !(plateMatches && plateMatches.length)) ? 'open' : '' %>>
      <summary>Новый авто и владелец</summary>
      <div class="order-form-grid" style="margin-top:8px;">
        <input type="hidden" name="vehicle_model_id" value="<%= order.vehicle_model_id || '' %>" />
        <label>Госномер <input name="new_plate" class="plate-search-input" data-plate-input value="<%= order.new_plate || plateQuery || '' %>" placeholder="А123ВС777" /></label>
        <label>Марка <input name="new_make" data-ac-mark value="<%= order.new_make || '' %>" autocomplete="off" /></label>
        <label>Модель <input name="new_model" data-ac-model value="<%= order.new_model || '' %>" autocomplete="off" /></label>
        <label>Кузов <input name="new_body_type" data-ac-body value="<%= order.new_body_type || '' %>" placeholder="Седан, SUV…" /></label>
        <label>Год <input name="new_year" data-ac-year value="<%= order.new_year || '' %>" inputmode="numeric" /></label>
        <label>VIN <input name="new_vin" value="<%= order.new_vin || '' %>" /></label>
        <label>ФИО владельца <input name="new_owner_name" value="<%= order.new_owner_name || '' %>" /></label>
        <label>Телефон <input name="new_owner_phone" value="<%= order.new_owner_phone || '' %>" inputmode="tel" placeholder="+7…" /></label>
      </div>
    </details>

    <label>Комментарий <textarea name="notes" rows="2"><%= order.notes || '' %></textarea></label>
    <button type="submit" class="btn btn-primary">Создать заказ</button>
  </form>
</section>
<%- include('../partials/layout-bottom', { extraScripts: ['/js/vehicle-autocomplete.js', '/js/work-type-picker.js'] }) %>
