<%- include('../partials/layout-top', { title: 'Каталог', user, category: 'catalog' }) %>
<section class="card">
  <% if (typeof synced !== 'undefined' && synced) { %>
    <div class="success-banner" style="margin-bottom:12px;">Справочник авто обновлён.</div>
  <% } %>
  <div class="catalog-toolbar">
    <form method="get" class="catalog-toolbar__filters">
      <label>Тип
        <select name="type">
          <option value="">Все</option>
          <option value="work" <%= filters.type === 'work' ? 'selected' : '' %>>Работы</option>
          <option value="product" <%= filters.type === 'product' ? 'selected' : '' %>>Товары</option>
        </select>
      </label>
      <label>Категория
        <input name="category" value="<%= filters.category || '' %>" placeholder="категория" />
      </label>
      <label>Поиск
        <input name="search" value="<%= filters.search || '' %>" />
      </label>
      <input type="hidden" name="view" value="<%= filters.view || 'cards' %>" id="catalog-view-input" />
      <button type="submit">Фильтр</button>
      <div class="catalog-view-toggle" role="group" aria-label="Вид">
        <button type="button" class="btn btn-sm catalog-view-btn <%= (filters.view || 'cards') === 'cards' ? 'active' : '' %>" data-view="cards">Карточки</button>
        <button type="button" class="btn btn-sm catalog-view-btn <%= filters.view === 'table' ? 'active' : '' %>" data-view="table">Таблица</button>
      </div>
    </form>
    <div class="catalog-toolbar__actions">
      <a class="btn btn-primary" href="/catalog/new">Добавить</a>
      <form method="post" action="/api/vehicles/sync">
        <button type="submit" class="btn btn-secondary btn-sm" title="Загрузить марки и модели с Auto.ru">Обновить справочник авто</button>
      </form>
    </div>
  </div>

  <% const viewMode = filters.view || 'cards'; %>
  <% if (viewMode === 'table') { %>
  <table class="catalog-table">
    <thead><tr><th>Тип</th><th>Категория</th><th>Название</th><th>Цена</th><th></th></tr></thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.type === 'work' ? 'Работа' : 'Товар' %></td>
          <td><%= i.category %></td>
          <td><%= i.name %><% if (!i.is_active) { %> <span class="muted">(выкл)</span><% } %></td>
          <td><%= Number(i.default_price).toFixed(2) %> ₽</td>
          <td>
            <a href="/catalog/<%= i.id %>/edit">Изм.</a>
            <form method="post" action="/catalog/<%= i.id %>/toggle" style="display:inline;"><button type="submit">⇄</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <div class="catalog-cards">
    <% items.forEach(i => { %>
      <article class="catalog-card <%= i.is_active ? '' : 'catalog-card--inactive' %>">
        <div class="catalog-card__type"><%= i.type === 'work' ? 'Работа' : 'Товар' %> · <%= i.category %></div>
        <h3 class="catalog-card__title"><%= i.name %></h3>
        <div class="catalog-card__price"><%= Number(i.default_price).toLocaleString('ru-RU') %> ₽<% if (i.unit) { %> <span class="muted">/ <%= i.unit %></span><% } %></div>
        <div class="catalog-card__actions">
          <a href="/catalog/<%= i.id %>/edit" class="btn btn-sm">Изменить</a>
          <form method="post" action="/catalog/<%= i.id %>/toggle"><button type="submit" class="btn btn-sm"><%= i.is_active ? 'Выкл' : 'Вкл' %></button></form>
        </div>
      </article>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
document.querySelectorAll('.catalog-view-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var input = document.getElementById('catalog-view-input');
    if (input) input.value = btn.dataset.view;
    btn.closest('form').submit();
  });
});
</script>
<%- include('../partials/layout-bottom') %>
