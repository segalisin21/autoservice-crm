<%- include('../partials/layout-top', { title: 'Каталог', user, category: 'catalog' }) %>
<section class="card">
  <% if (typeof synced !== 'undefined' && synced) { %>
    <div class="success-banner" style="margin-bottom:12px;">
      Справочник авто обновлён<% if (typeof syncSource !== 'undefined' && syncSource === 'seed') { %> (из локальной базы — Auto.ru с сервера недоступен)<% } %>.
    </div>
  <% } %>
  <div class="catalog-toolbar">
    <form method="get" class="catalog-toolbar__filters">
      <label>Тип
        <select name="type">
          <option value="">Все</option>
          <option value="work" <%= filters.type === 'work' ? 'selected' : '' %>>Работы</option>
          <option value="product" <%= filters.type === 'product' ? 'selected' : '' %>>Товары</option>
        </select>
      </label>
      <label>Категория
        <input name="category" value="<%= filters.category || '' %>" placeholder="категория" />
      </label>
      <label>Поиск
        <input name="search" value="<%= filters.search || '' %>" />
      </label>
      <input type="hidden" name="view" value="<%= filters.view || 'cards' %>" id="catalog-view-input" />
      <button type="submit">Фильтр</button>
      <div class="catalog-view-toggle" role="group" aria-label="Вид">
        <button type="button" class="btn btn-sm catalog-view-btn <%= (filters.view || 'cards') === 'cards' ? 'active' : '' %>" data-view="cards">Карточки</button>
        <button type="button" class="btn btn-sm catalog-view-btn <%= filters.view === 'table' ? 'active' : '' %>" data-view="table">Таблица</button>
      </div>
    </form>
    <div class="catalog-toolbar__actions">
      <a class="btn btn-primary" href="/catalog/new">Добавить</a>
      <form method="post" action="/api/vehicles/sync">
        <button type="submit" class="btn btn-secondary btn-sm" title="Загрузить марки и модели с Auto.ru">Обновить справочник авто</button>
      </form>
    </div>
  </div>

  <% const viewMode = filters.view || 'cards'; %>
  <% if (viewMode === 'table') { %>
  <table class="catalog-table">
    <thead><tr><th>Артикул</th><th>Тип</th><th>Категория</th><th>Название</th><th>Цена</th><th>Расходник</th><th></th></tr></thead>
    <tbody>
      <% items.forEach(i => { %>
        <tr>
          <td><code><%= i.article || '—' %></code></td>
          <td><%= i.type === 'work' ? 'Работа' : 'Товар' %></td>
          <td><%= i.category %></td>
          <td>
            <%= i.name %><% if (!i.is_active) { %> <span class="muted">(выкл)</span><% } %>
            <% if (i.description) { %><div class="muted" style="font-size:12px; margin-top:2px;"><%= i.description.split('\n')[0].slice(0, 60) %><% if (i.description.length > 60) { %>…<% } %></div><% } %>
          </td>
          <td>
            <%= Number(i.default_price).toFixed(0) %> ₽
            <% if (i.price_tier_2 || i.price_tier_3) { %>
              <span class="muted" style="font-size:11px;"> / <%= i.price_tier_2 ? Number(i.price_tier_2).toFixed(0) : '—' %> / <%= i.price_tier_3 ? Number(i.price_tier_3).toFixed(0) : '—' %></span>
            <% } %>
          </td>
          <td><%= Number(i.default_material_cost || 0) > 0 ? Number(i.default_material_cost).toFixed(0) + ' ₽' : '—' %></td>
          <td style="display:flex; gap:4px; flex-wrap:wrap;">
            <a href="/catalog/<%= i.id %>/edit">Изм.</a>
            <form method="post" action="/catalog/<%= i.id %>/toggle" style="display:inline;"><button type="submit">⇄</button></form>
            <form method="post" action="/catalog/<%= i.id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('Удалить позицию?');"><button type="submit">Удалить</button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } else { %>
  <div class="catalog-cards">
    <% items.forEach(i => { %>
      <article class="catalog-card <%= i.is_active ? '' : 'catalog-card--inactive' %>">
        <div class="catalog-card__type"><%= i.type === 'work' ? 'Работа' : 'Товар' %> · <%= i.category %><% if (i.article) { %> · <code><%= i.article %></code><% } %></div>
        <h3 class="catalog-card__title"><%= i.name %></h3>
        <% if (i.description) { %><p class="catalog-card__desc muted" style="font-size:13px; margin:4px 0;"><%= i.description.split('\n').slice(0, 2).join(' · ') %><% if (i.description.split('\n').length > 2) { %>…<% } %></p><% } %>
        <div class="catalog-card__price">
          <%= Number(i.default_price).toLocaleString('ru-RU') %> ₽
          <% if (i.price_tier_2 || i.price_tier_3) { %>
            <span class="muted" style="font-size:12px;"> (2/3 кат.: <%= i.price_tier_2 ? Number(i.price_tier_2).toLocaleString('ru-RU') : '—' %> / <%= i.price_tier_3 ? Number(i.price_tier_3).toLocaleString('ru-RU') : '—' %>)</span>
          <% } %>
          <% if (i.unit) { %> <span class="muted">/ <%= i.unit %></span><% } %>
        </div>
        <% if (Number(i.default_material_cost || 0) > 0) { %>
          <div class="muted" style="font-size:12px; margin-top:4px;">Расходник: <%= Number(i.default_material_cost).toLocaleString('ru-RU') %> ₽</div>
        <% } %>
        <div class="catalog-card__actions">
          <a href="/catalog/<%= i.id %>/edit" class="btn btn-sm">Изменить</a>
          <form method="post" action="/catalog/<%= i.id %>/toggle"><button type="submit" class="btn btn-sm"><%= i.is_active ? 'Выкл' : 'Вкл' %></button></form>
          <form method="post" action="/catalog/<%= i.id %>?_method=DELETE" onsubmit="return confirm('Удалить позицию?');"><button type="submit" class="btn btn-sm">Удалить</button></form>
        </div>
      </article>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
document.querySelectorAll('.catalog-view-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var input = document.getElementById('catalog-view-input');
    if (input) input.value = btn.dataset.view;
    btn.closest('form').submit();
  });
});
</script>
<%- include('../partials/layout-bottom') %>
