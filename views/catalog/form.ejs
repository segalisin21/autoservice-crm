<%- include('../partials/layout-top', { title: item.id ? 'Позиция каталога' : 'Новая позиция', user, extraScripts: typeof extraScripts !== 'undefined' ? extraScripts : ['/js/catalog-article-form.js'] }) %>
<section class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="<%= item.id ? '/catalog/' + item.id + '?_method=PUT' : '/catalog' %>" data-item-id="<%= item.id || '' %>" class="catalog-form-compact">
    <div class="catalog-form-grid">
      <label>Тип
        <select name="type">
          <option value="work" <%= item.type === 'work' ? 'selected' : '' %>>Работа</option>
          <option value="product" <%= item.type === 'product' ? 'selected' : '' %>>Товар</option>
        </select>
      </label>
      <label>Артикул
        <div class="catalog-article-row">
          <input name="article" required value="<%= item.article || '' %>" autocomplete="off" />
          <button type="button" class="btn btn-secondary btn-sm" id="catalog-suggest-article">Предложить</button>
        </div>
      </label>
      <label>Категория
        <input name="category" required value="<%= item.category || '' %>" placeholder="Мойка, Электрика, Продажа" list="work-type-hints" />
        <datalist id="work-type-hints">
          <option value="Мойка"></option>
          <option value="Электрика"></option>
          <option value="Продажа"></option>
        </datalist>
      </label>
      <label>Название <input name="name" required value="<%= item.name || '' %>" /></label>
      <label>Ед. <input name="unit" value="<%= item.unit || '' %>" placeholder="шт, усл." /></label>
      <label>Сортировка <input name="sort_order" type="number" value="<%= item.sort_order || 0 %>" /></label>
      <label>Активна
        <select name="is_active">
          <option value="1" <%= item.is_active !== 0 ? 'selected' : '' %>>да</option>
          <option value="0" <%= item.is_active === 0 ? 'selected' : '' %>>нет</option>
        </select>
      </label>
    </div>
    <div id="catalog-article-conflict" class="error" hidden style="margin-top:4px;"></div>
    <label>Описание / что входит
      <textarea name="description" rows="4" placeholder="Состав комплекса, пункты через строку"><%= item.description || '' %></textarea>
    </label>
    <fieldset class="catalog-price-fieldset">
      <legend>Цены и расходники (для мойки — по категории авто, клиент не видит)</legend>
      <div class="catalog-price-grid catalog-price-grid--tiers">
        <div class="catalog-tier-column">
          <span class="catalog-tier-column__title">1 кат. (седан)</span>
          <label>Цена, ₽ <input name="default_price" value="<%= item.default_price != null ? item.default_price : '' %>" inputmode="decimal" /></label>
          <label>Расходник, ₽
            <input name="default_material_cost" value="<%= item.default_material_cost != null && Number(item.default_material_cost) ? item.default_material_cost : '' %>" inputmode="decimal" placeholder="0" />
          </label>
        </div>
        <div class="catalog-tier-column">
          <span class="catalog-tier-column__title">2 кат. (паркетник)</span>
          <label>Цена, ₽ <input name="price_tier_2" value="<%= item.price_tier_2 != null ? item.price_tier_2 : '' %>" inputmode="decimal" placeholder="необязательно" /></label>
          <label>Расходник, ₽
            <input name="material_cost_tier_2" value="<%= item.material_cost_tier_2 != null && Number(item.material_cost_tier_2) ? item.material_cost_tier_2 : '' %>" inputmode="decimal" placeholder="необязательно" />
          </label>
        </div>
        <div class="catalog-tier-column">
          <span class="catalog-tier-column__title">3 кат. (внедорожник)</span>
          <label>Цена, ₽ <input name="price_tier_3" value="<%= item.price_tier_3 != null ? item.price_tier_3 : '' %>" inputmode="decimal" placeholder="необязательно" /></label>
          <label>Расходник, ₽
            <input name="material_cost_tier_3" value="<%= item.material_cost_tier_3 != null && Number(item.material_cost_tier_3) ? item.material_cost_tier_3 : '' %>" inputmode="decimal" placeholder="необязательно" />
          </label>
        </div>
      </div>
      <p class="muted catalog-field-hint">Расходник подставляется в заказ при выборе категории авто и учитывается при расчёте ЗП (net %). Если для 2/3 кат. не указан — берётся расходник 1 кат.</p>
    </fieldset>
    <fieldset class="catalog-price-fieldset catalog-payroll-fieldset" id="catalog-payroll-fieldset">
      <legend>Зарплата по услуге</legend>
      <label>Фикс. ЗП, ₽
        <input name="payroll_fixed" value="<%= item.payroll_fixed != null ? item.payroll_fixed : '' %>" inputmode="decimal" placeholder="не задано — по правилам мастера" />
      </label>
      <p class="muted catalog-field-hint">Если указано — мастер получает эту сумму за выполнение услуги (не зависит от цены для клиента). При нескольких мастерах сумма делится между ними. Персональное переопределение в разделе «Зарплата» имеет приоритет.</p>
    </fieldset>
    <div class="compact-actions catalog-form-actions">
      <button type="submit" class="btn btn-primary">Сохранить</button>
      <a class="btn btn-secondary" href="/catalog">Назад</a>
      <% if (item.id) { %>
      <button type="submit" class="btn btn-sm btn-delete catalog-delete-btn" formaction="/catalog/<%= item.id %>?_method=DELETE" formmethod="post" onclick="return confirm('Удалить позицию из каталога?');">Удалить</button>
      <% } %>
    </div>
  </form>
</section>
<%- include('../partials/layout-bottom') %>
