<%- include('../partials/layout-top', { title: item.id ? 'Позиция каталога' : 'Новая позиция', user }) %>
<section class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="<%= item.id ? '/catalog/' + item.id + '?_method=PUT' : '/catalog' %>">
    <label>Тип
      <select name="type">
        <option value="work" <%= item.type === 'work' ? 'selected' : '' %>>Работа</option>
        <option value="product" <%= item.type === 'product' ? 'selected' : '' %>>Товар</option>
      </select>
    </label>
    <label>Категория
      <input name="category" required value="<%= item.category || '' %>" placeholder="Мойка, Электрика, Продажа" list="work-type-hints" />
      <datalist id="work-type-hints">
        <option value="Мойка"></option>
        <option value="Электрика"></option>
        <option value="Продажа"></option>
      </datalist>
    </label>
    <label>Название <input name="name" required value="<%= item.name || '' %>" /></label>
    <label>Цена по умолчанию <input name="default_price" value="<%= item.default_price != null ? item.default_price : '' %>" inputmode="decimal" /></label>
    <label>Ед. <input name="unit" value="<%= item.unit || '' %>" placeholder="шт, усл." /></label>
    <label>Сортировка <input name="sort_order" type="number" value="<%= item.sort_order || 0 %>" /></label>
    <label>Активна
      <select name="is_active">
        <option value="1" <%= item.is_active !== 0 ? 'selected' : '' %>>да</option>
        <option value="0" <%= item.is_active === 0 ? 'selected' : '' %>>нет</option>
      </select>
    </label>
    <button type="submit" class="btn-primary" style="margin-top:12px;">Сохранить</button>
  </form>
</section>
<%- include('../partials/layout-bottom') %>
