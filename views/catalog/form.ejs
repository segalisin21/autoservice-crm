<%- include('../partials/layout-top', { title: item.id ? 'Позиция каталога' : 'Новая позиция', user, extraScripts: typeof extraScripts !== 'undefined' ? extraScripts : ['/js/catalog-article-form.js'] }) %>
<section class="card">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="<%= item.id ? '/catalog/' + item.id + '?_method=PUT' : '/catalog' %>" data-item-id="<%= item.id || '' %>">
    <label>Тип
      <select name="type">
        <option value="work" <%= item.type === 'work' ? 'selected' : '' %>>Работа</option>
        <option value="product" <%= item.type === 'product' ? 'selected' : '' %>>Товар</option>
      </select>
    </label>
    <label>Артикул
      <div style="display:flex; gap:8px; align-items:center;">
        <input name="article" required value="<%= item.article || '' %>" autocomplete="off" style="flex:1;" />
        <button type="button" class="btn btn-secondary btn-sm" id="catalog-suggest-article">Предложить</button>
      </div>
    </label>
    <div id="catalog-article-conflict" class="error" hidden style="margin-top:4px;"></div>
    <label>Категория
      <input name="category" required value="<%= item.category || '' %>" placeholder="Мойка, Электрика, Продажа" list="work-type-hints" />
      <datalist id="work-type-hints">
        <option value="Мойка"></option>
        <option value="Электрика"></option>
        <option value="Продажа"></option>
      </datalist>
    </label>
    <label>Название <input name="name" required value="<%= item.name || '' %>" /></label>
    <label>Описание / что входит
      <textarea name="description" rows="4" placeholder="Состав комплекса, пункты через строку"><%= item.description || '' %></textarea>
    </label>
    <fieldset style="border:1px solid var(--gray-200,#e5e7eb); padding:12px; border-radius:8px;">
      <legend>Цены (для мойки — по категории авто, клиент не видит)</legend>
      <label>1 кат. (седан) <input name="default_price" value="<%= item.default_price != null ? item.default_price : '' %>" inputmode="decimal" /></label>
      <label>2 кат. (паркетник) <input name="price_tier_2" value="<%= item.price_tier_2 != null ? item.price_tier_2 : '' %>" inputmode="decimal" placeholder="необязательно" /></label>
      <label>3 кат. (внедорожник) <input name="price_tier_3" value="<%= item.price_tier_3 != null ? item.price_tier_3 : '' %>" inputmode="decimal" placeholder="необязательно" /></label>
    </fieldset>
    <label>Ед. <input name="unit" value="<%= item.unit || '' %>" placeholder="шт, усл." /></label>
    <label>Сортировка <input name="sort_order" type="number" value="<%= item.sort_order || 0 %>" /></label>
    <label>Активна
      <select name="is_active">
        <option value="1" <%= item.is_active !== 0 ? 'selected' : '' %>>да</option>
        <option value="0" <%= item.is_active === 0 ? 'selected' : '' %>>нет</option>
      </select>
    </label>
    <div style="display:flex; gap:8px; margin-top:12px; flex-wrap:wrap;">
      <button type="submit" class="btn-primary">Сохранить</button>
      <a class="btn btn-secondary" href="/catalog">Назад</a>
      <% if (item.id) { %>
      <button type="submit" class="btn btn-sm catalog-delete-btn" formaction="/catalog/<%= item.id %>?_method=DELETE" formmethod="post" onclick="return confirm('Удалить позицию из каталога?');" style="color:var(--danger, #c00);">Удалить</button>
      <% } %>
    </div>
  </form>
</section>
<%- include('../partials/layout-bottom') %>
