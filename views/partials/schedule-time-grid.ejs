<% if (timeGrid.noTime && timeGrid.noTime.length) { %>
<div class="schedule-no-time-banner">
  <div class="garage-bay-header">
    <span>Без времени</span>
    <span class="garage-bay-count"><%= timeGrid.noTime.length %></span>
  </div>
  <table class="data-table-compact schedule-no-time-table">
    <tbody>
      <% timeGrid.noTime.forEach(function(o) { %>
        <tr>
          <td><a href="/orders/<%= o.id %>">#<%= o.id %></a></td>
          <td><%= o.license_plate || o.car_label || 'Авто' %></td>
          <td><%= o.client_name || '—' %></td>
          <td><span class="status-badge status-<%= o.status %>"><%= statusLabel(o.status) %></span></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<div class="schedule-time-grid-scroll">
  <% const gridCols = timeGrid.columns || []; %>
  <% const hasMultiLane = gridCols.some(function(c) { return (c.maxLanes || 1) > 1; }); %>
  <table class="schedule-table schedule-time-grid">
    <colgroup>
      <col class="schedule-time-col" />
      <% gridCols.forEach(function(col) { %>
        <% const laneCount = col.maxLanes || 1; %>
        <% for (let laneIdx = 0; laneIdx < laneCount; laneIdx++) { %>
          <col class="schedule-lane-col<%= laneCount > 1 ? ' schedule-lane-col--split' : '' %>" />
        <% } %>
      <% }); %>
    </colgroup>
    <thead>
      <tr>
        <th class="time-col"<% if (hasMultiLane) { %> rowspan="2"<% } %>>Время</th>
        <% gridCols.forEach(function(col, colIdx) { %>
          <% const laneCount = col.maxLanes || 1; %>
          <th class="resource-col resource-col--grouped <%= col.has_absence ? 'resource-col--absent' : '' %><% if (laneCount > 1) { %> resource-col--multi-lane<% } %>" colspan="<%= laneCount %>" data-employee="<%= col.id %>" data-max-lanes="<%= laneCount %>">
            <div class="resource-header">
              <% if (typeof canMutateOrders !== 'undefined' && canMutateOrders && colIdx > 0) { %>
                <form method="post" action="/schedule/columns/reorder" class="schedule-col-reorder-form">
                  <input type="hidden" name="user_id" value="<%= col.id %>" />
                  <input type="hidden" name="direction" value="left" />
                  <input type="hidden" name="date" value="<%= scheduleDate %>" />
                  <button type="submit" class="schedule-col-arrow" title="Левее">←</button>
                </form>
              <% } else if (typeof canMutateOrders !== 'undefined' && canMutateOrders) { %>
                <span class="schedule-col-arrow schedule-col-arrow--placeholder" aria-hidden="true"></span>
              <% } %>
              <div class="resource-name">
                <%= col.name %>
                <% if (col.has_absence) { %><span class="resource-absence-dot" title="<%= (col.absence_labels || []).join(', ') %>"></span><% } %>
              </div>
              <% if (typeof canMutateOrders !== 'undefined' && canMutateOrders && colIdx < gridCols.length - 1) { %>
                <form method="post" action="/schedule/columns/reorder" class="schedule-col-reorder-form">
                  <input type="hidden" name="user_id" value="<%= col.id %>" />
                  <input type="hidden" name="direction" value="right" />
                  <input type="hidden" name="date" value="<%= scheduleDate %>" />
                  <button type="submit" class="schedule-col-arrow" title="Правее">→</button>
                </form>
              <% } else if (typeof canMutateOrders !== 'undefined' && canMutateOrders) { %>
                <span class="schedule-col-arrow schedule-col-arrow--placeholder" aria-hidden="true"></span>
              <% } %>
            </div>
          </th>
        <% }); %>
      </tr>
      <% if (hasMultiLane) { %>
      <tr class="schedule-lane-header-row">
        <% gridCols.forEach(function(col) { %>
          <% const laneCount = col.maxLanes || 1; %>
          <% for (let laneIdx = 0; laneIdx < laneCount; laneIdx++) { %>
            <th class="schedule-lane-header<%= laneIdx > 0 ? ' schedule-lane-header--not-first' : '' %>" data-employee="<%= col.id %>" data-lane="<%= laneIdx %>" aria-hidden="<%= laneCount === 1 ? 'true' : 'false' %>"></th>
          <% } %>
        <% }); %>
      </tr>
      <% } %>
    </thead>
    <tbody>
      <% (timeGrid.hours || []).forEach(function(slot) { %>
        <tr>
          <td class="time-cell"><%= slot.label %></td>
          <% gridCols.forEach(function(col) { %>
            <% const laneCount = col.maxLanes || 1; %>
            <% for (let laneIdx = 0; laneIdx < laneCount; laneIdx++) { %>
              <% const lane = (col.lanes && col.lanes[laneIdx]) || { byHour: {}, coveredBySpan: {} }; %>
              <% const slotOrders = lane.byHour[slot.hour] || []; %>
              <% const coveredBySpan = !!(lane.coveredBySpan && lane.coveredBySpan[slot.hour]); %>
              <% if (coveredBySpan) { %>
              <% } else { %>
              <% const isAbsent = col.absentByHour && col.absentByHour[slot.hour]; %>
              <% const cellSpanRows = slotOrders.length === 1 && (slotOrders[0].span_rows || 1) > 1 ? slotOrders[0].span_rows : 1; %>
              <td class="slot-cell schedule-lane-cell<%= cellSpanRows > 1 ? ' slot-cell--spanning' : '' %> <%= isAbsent ? 'slot-cell--absent' : '' %><% if (laneCount > 1) { %> slot-cell--multi-lane<% } %><% if (laneIdx > 0) { %> schedule-lane-cell--not-first<% } %>" data-hour="<%= slot.hour %>" data-employee="<%= col.id %>" data-lane="<%= laneIdx %>"<% if (cellSpanRows > 1) { %> rowspan="<%= cellSpanRows %>" data-span-rows="<%= cellSpanRows %>"<% } %>>
                <% if (!slotOrders.length && isAbsent) { %>
                  <span class="slot-absent-label">Отсутствует</span>
                <% } else if (!slotOrders.length) { %>
                  <span class="slot-free">—</span>
                <% } else { %>
                  <% slotOrders.forEach(function(o) { %>
                    <div class="schedule-order-block<%= typeof canMutateOrders !== 'undefined' && canMutateOrders ? ' schedule-order-block--draggable' : '' %>"
                      <% if (typeof canMutateOrders !== 'undefined' && canMutateOrders) { %>
                        draggable="true"
                        data-order-id="<%= o.id %>"
                        data-assigned-user-id="<%= o.assigned_user_id || '' %>"
                        data-start-time="<%= o.start_time || '' %>"
                        data-end-time="<%= o.end_time || '' %>"
                      <% } %>>
                      <a href="/orders/<%= o.id %>" class="schedule-order-line status-<%= o.status %><% if (o.absence_conflict) { %> order-card--absence-conflict<% } %><% if ((o.span_rows || 1) > 1) { %> schedule-order-line--fill schedule-order-line--span-<%= o.span_rows || 1 %><% } %><% if (laneCount > 1) { %> schedule-order-line--compact<% } %>" title="#<%= o.id %> · <%= o.client_name || '—' %>">
                        <span class="schedule-order-line__time"><%= o.start_time || slot.label %><% if (o.end_time) { %>–<%= o.end_time %><% } %></span>
                        <span class="schedule-order-line__main"><%= o.car_label || o.license_plate || 'Авто' %></span>
                        <% if (laneCount === 1 || (o.span_rows || 1) > 1) { %>
                        <span class="schedule-order-line__meta">#<%= o.id %> · <%= o.client_name || '—' %><% if (o.end_date_badge) { %> · <%= o.end_date_badge %><% } %><% if (typeof showMoney !== 'undefined' && showMoney && o.total_price > 0) { %> · <%= o.total_price.toLocaleString('ru-RU') %> ₽<% } %></span>
                        <% } else { %>
                        <span class="schedule-order-line__meta schedule-order-line__meta--id">#<%= o.id %></span>
                        <% } %>
                        <% if (o.absence_conflict) { %><span class="order-absence-marker" title="Мастер отсутствует в это время">●</span><% } %>
                      </a>
                    </div>
                  <% }); %>
                <% } %>
              </td>
              <% } %>
            <% } %>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
