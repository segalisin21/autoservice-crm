<% if (timeGrid.noTime && timeGrid.noTime.length) { %>
<div class="schedule-no-time-banner">
  <div class="garage-bay-header">
    <span>Без времени</span>
    <span class="garage-bay-count"><%= timeGrid.noTime.length %></span>
  </div>
  <div class="schedule-no-time-cards">
    <% timeGrid.noTime.forEach(function(o) { %>
      <%- include('order-card', { o: o, statusLabel: statusLabel }) %>
    <% }); %>
  </div>
</div>
<% } %>

<div class="schedule-time-grid-scroll">
  <table class="schedule-table schedule-time-grid">
    <thead>
      <tr>
        <th class="time-col">Время</th>
        <% (timeGrid.columns || []).forEach(function(col) { %>
          <th class="resource-col <%= col.has_absence ? 'resource-col--absent' : '' %>">
            <div class="resource-name">
              <%= col.name %>
              <% if (col.has_absence) { %><span class="resource-absence-dot" title="<%= (col.absence_labels || []).join(', ') %>"></span><% } %>
            </div>
          </th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <% (timeGrid.hours || []).forEach(function(slot) { %>
        <tr>
          <td class="time-cell"><%= slot.label %></td>
          <% (timeGrid.columns || []).forEach(function(col) { %>
            <% const slotOrders = (col.byHour && col.byHour[slot.hour]) ? col.byHour[slot.hour] : []; %>
            <% const isAbsent = col.absentByHour && col.absentByHour[slot.hour]; %>
            <td class="slot-cell <%= isAbsent ? 'slot-cell--absent' : '' %>" data-hour="<%= slot.hour %>" data-employee="<%= col.id %>">
              <% if (!slotOrders.length && isAbsent) { %>
                <span class="slot-absent-label">Отсутствует</span>
              <% } else if (!slotOrders.length) { %>
                <span class="slot-free">—</span>
              <% } else { %>
                <% slotOrders.forEach(function(o) { %>
                  <%- include('order-card', { o: o, statusLabel: statusLabel }) %>
                <% }); %>
              <% } %>
            </td>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
