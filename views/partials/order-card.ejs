<% const isCompactOrderCard = typeof compact !== 'undefined' && compact; %>
<% const orderDraggable = typeof canMutateOrders !== 'undefined' && canMutateOrders; %>
<% if (orderDraggable) { %>
<div class="garage-order-block schedule-order-block--draggable"
  draggable="true"
  data-order-id="<%= o.id %>"
  data-assigned-user-id="<%= o.assigned_user_id || '' %>"
  data-start-time="<%= o.start_time || '' %>"
  data-end-time="<%= o.end_time || '' %>">
<% } %>
<a href="/orders/<%= o.id %>" class="garage-order-card <%= isCompactOrderCard ? 'garage-order-card--compact' : '' %> status-<%= o.status %><% if (o.absence_conflict) { %> order-card--absence-conflict<% } %>">
  <div class="garage-order-head">
    <span class="garage-order-id">#<%= o.id %></span>
    <span class="garage-order-status"><%= statusLabel(o.status) %></span>
    <% if (o.absence_conflict) { %><span class="order-absence-marker" title="Мастер отсутствует в это время">●</span><% } %>
  </div>
  <div class="garage-order-car"><%= o.car_label || o.license_plate || 'Авто' %></div>
  <% if (!isCompactOrderCard) { %>
    <div class="garage-order-client"><%= o.client_name %><% if (o.client_phone) { %> · <%= o.client_phone %><% } %></div>
  <% } %>
  <div class="garage-order-meta">
    <% if (o.start_time) { %><span><%= o.start_time %><% if (o.end_time) { %>–<%= o.end_time %><% } %></span><% } %>
    <% if (o.work_type) { %><span><%= o.work_type %></span><% } %>
    <% if (typeof showMoney !== 'undefined' && showMoney && o.total_price > 0) { %><span><%= o.total_price.toLocaleString('ru-RU') %> ₽</span><% } %>
  </div>
</a>
<% if (orderDraggable) { %>
  <%- include('schedule-master-select', { o: o, canMutateOrders: canMutateOrders, scheduleMasters: typeof scheduleMasters !== 'undefined' ? scheduleMasters : [] }) %>
</div>
<% } %>
