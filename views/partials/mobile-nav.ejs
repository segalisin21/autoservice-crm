<% if (typeof user !== 'undefined' && user) {
  var isMaster = user.role === 'master';
  var isStaff = user.role === 'owner' || user.role === 'admin';
%>
<nav class="mobile-bottom-nav" aria-label="Мобильная навигация">
  <a href="/" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'dashboard' ? 'active' : '' %>">
    <span class="mobile-nav-icon">📅</span>
    <span>Главная</span>
  </a>
  <a href="/orders" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'orders' ? 'active' : '' %>">
    <span class="mobile-nav-icon">📋</span>
    <span>Заказы</span>
  </a>
  <% if (isStaff) { %>
  <a href="/orders/new" class="mobile-nav-item mobile-nav-item--fab">
    <span class="mobile-nav-icon">＋</span>
    <span>Новый</span>
  </a>
  <a href="/expenses" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'expenses' ? 'active' : '' %>">
    <span class="mobile-nav-icon">💸</span>
    <span>Расходы</span>
  </a>
  <% } %>
  <details class="mobile-nav-more">
    <summary class="mobile-nav-item">
      <span class="mobile-nav-icon">☰</span>
      <span>Ещё</span>
    </summary>
    <div class="mobile-nav-more-menu">
      <a href="/journal">Журнал</a>
      <a href="/clients">Клиенты</a>
      <% if (isStaff) { %>
      <a href="/admin/finance">Финансы</a>
      <a href="/admin/payroll">Зарплата</a>
      <a href="/admin/users">Сотрудники</a>
      <% } %>
      <form action="/logout" method="POST"><button type="submit">Выйти</button></form>
    </div>
  </details>
</nav>
<% } %>
