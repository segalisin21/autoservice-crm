<% if (typeof user !== 'undefined' && user) {
  var _can = typeof can === 'function' ? can : function () { return true; };
  var _isMaster = user.role === 'master';
%>
<nav class="mobile-bottom-nav" aria-label="Мобильная навигация">
  <% if (_can('dashboard:view')) { %>
  <a href="/" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'dashboard' ? 'active' : '' %>">
    <span class="mobile-nav-icon">📅</span>
    <span>Главная</span>
  </a>
  <% } %>
  <% if (_can('orders:view') && !_isMaster) { %>
  <a href="/orders" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'orders' ? 'active' : '' %>">
    <span class="mobile-nav-icon">📋</span>
    <span>Заказы</span>
  </a>
  <% } %>
  <% if (_can('orders:mutate')) { %>
  <a href="/orders/new" class="mobile-nav-item mobile-nav-item--fab">
    <span class="mobile-nav-icon">＋</span>
    <span>Новый</span>
  </a>
  <% } %>
  <% if (_isMaster && _can('payroll:view')) { %>
  <a href="/admin/payroll" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'payroll' ? 'active' : '' %>">
    <span class="mobile-nav-icon">💰</span>
    <span>Моя ЗП</span>
  </a>
  <% } %>
  <% if (_can('expenses:view')) { %>
  <a href="/expenses" class="mobile-nav-item <%= typeof category !== 'undefined' && category === 'expenses' ? 'active' : '' %>">
    <span class="mobile-nav-icon">💸</span>
    <span>Расходы</span>
  </a>
  <% } %>
  <details class="mobile-nav-more">
    <summary class="mobile-nav-item">
      <span class="mobile-nav-icon">☰</span>
      <span>Ещё</span>
    </summary>
    <div class="mobile-nav-more-menu">
      <% if (_can('admin:reports')) { %><a href="/journal">Журнал</a><% } %>
      <% if (_can('clients:view')) { %><a href="/clients">Клиенты</a><% } %>
      <% if (_can('cars:view')) { %><a href="/cars">Авто</a><% } %>
      <% if (_can('admin:reports')) { %>
      <a href="/admin/finance">Финансы</a>
      <a href="/admin/orders-economics">Экономика заказов</a>
      <% } %>
      <% if (_can('payroll:view') && !_isMaster) { %><a href="/admin/payroll">Зарплата</a><% } %>
      <% if (_can('admin:reports')) { %><a href="/admin/reports">Аналитика</a><% } %>
      <% if (_can('admin:reports')) { %><a href="/admin/market">Рынок</a><% } %>
      <% if (_can('admin:users')) { %><a href="/admin/users">Сотрудники</a><% } %>
      <form action="/logout" method="POST">
    <%- include('csrf-field') %><button type="submit">Выйти</button></form>
    </div>
  </details>
</nav>
<% } %>
