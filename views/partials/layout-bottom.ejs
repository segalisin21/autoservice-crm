      </div>
    </main>
  </div>
  <%- include('mobile-nav', { user: typeof user !== 'undefined' ? user : null, category: typeof category !== 'undefined' ? category : '' }) %>
  <div id="flash-messages"></div>
  <script src="/js/app.js"></script>
  <script src="/js/plate-input.js"></script>
  <% if (typeof extraScripts !== 'undefined' && extraScripts) { extraScripts.forEach(function(src) { if (src !== '/js/plate-input.js') { %>
  <script src="<%= src %>"></script>
  <% } }); } %>
</body>
</html>
