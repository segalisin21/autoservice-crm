<% var _cat = typeof category !== 'undefined' ? category : 'app'; %>
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CRM' %> — Автосервис</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#16a34a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Автосервис">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/autoservice.css">
</head>
<body class="<%= typeof category !== 'undefined' ? 'page-' + category : '' %>">
  <div class="layout-overlay" id="layout-overlay" aria-hidden="true"></div>
  <div class="app-container">
    <aside class="sidebar" id="app-sidebar" aria-label="Навигация">
      <div class="sidebar-brand">
        <div class="sidebar-brand-text">
          <span class="sidebar-logo-mark" aria-hidden="true">🔧</span>
          <h1 class="sidebar-title">Автосервис</h1>
        </div>
        <button type="button" class="sidebar-close" id="btn-nav-close" aria-label="Закрыть меню">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="sidebar-nav">
        <a href="/" class="nav-item <%= _cat === 'dashboard' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Календарь</span>
        </a>
        <a href="/orders" class="nav-item <%= _cat === 'orders' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <span>Заказы</span>
        </a>
        <a href="/clients" class="nav-item <%= _cat === 'clients' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Клиенты</span>
        </a>
        <a href="/cars" class="nav-item <%= _cat === 'cars' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 17h14M5 17l1-4h12l1 4M7 13l1.5-4h7L17 13M6 17a2 2 0 104 0M14 17a2 2 0 104 0"/>
          </svg>
          <span>Авто</span>
        </a>
        <a href="/journal" class="nav-item <%= _cat === 'journal' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 10h16M4 14h10M4 18h8"/>
          </svg>
          <span>Журнал</span>
        </a>
        <a href="/catalog" class="nav-item <%= _cat === 'catalog' ? 'active' : '' %>">
          <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          <span>Каталог</span>
        </a>
        <details class="sidebar-admin-details" open>
          <summary class="sidebar-admin-summary">
            <span>Администрирование</span>
            <svg class="sidebar-admin-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="sidebar-admin-inner">
            <a href="/expenses" class="nav-item <%= _cat === 'expenses' ? 'active' : '' %>">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 10h18M7 15h2m6 0h2M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"/>
              </svg>
              <span>Расходы</span>
            </a>
            <a href="/admin/users" class="nav-item <%= _cat === 'users' ? 'active' : '' %>">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Сотрудники</span>
            </a>
            <a href="/admin/orders-economics" class="nav-item <%= _cat === 'finance' ? 'active' : '' %>">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 17v-2m3 2v-4m3 4v-6M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>Экономика заказов</span>
            </a>
            <a href="/admin/finance" class="nav-item">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7H14a3 3 0 010 6H6"/>
              </svg>
              <span>Финансы</span>
            </a>
            <a href="/admin/payroll" class="nav-item <%= _cat === 'payroll' ? 'active' : '' %>">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 12v-2m9-4a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span>Зарплата</span>
            </a>
            <a href="/admin/reports" class="nav-item <%= _cat === 'reports' ? 'active' : '' %>">
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              <span>Отчёты</span>
            </a>
          </div>
        </details>
      </nav>
      <div class="sidebar-footer">
        <div class="date-display"><span id="current-date"></span></div>
      </div>
    </aside>
    <main class="main-content">
      <header class="top-bar">
        <div class="top-bar-left">
          <button type="button" class="btn-sidebar-toggle" id="btn-nav-open" aria-label="Открыть меню">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <h2 class="page-title"><%= typeof title !== 'undefined' ? title : 'CRM' %></h2>
        </div>
        <div class="top-bar-actions">
          <a href="/orders/new" class="btn btn-primary btn-sm">Новый заказ</a>
          <% if (typeof user !== 'undefined' && user) { %>
          <div class="top-bar-user">
            <div class="top-bar-user-text">
              <p class="top-bar-user-name"><%= user.name || user.username %></p>
              <p class="top-bar-user-role"><%= user.role %></p>
            </div>
            <form action="/logout" method="POST" class="logout-form">
              <button type="submit" class="btn-logout" title="Выйти">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4m7 14l5-5-5-5m5 5H9"/></svg>
                <span>Выйти</span>
              </button>
            </form>
          </div>
          <% } %>
        </div>
      </header>
      <div class="content">
