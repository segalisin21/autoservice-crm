<% const selected = Array.isArray(selectedWorkTypes) ? selectedWorkTypes : []; %>
<% const workTypeRequired = typeof workTypeRequired !== 'undefined' && workTypeRequired; %>
<div class="work-type-checkboxes" data-work-type-picker<%= workTypeRequired ? ' data-work-type-required' : '' %>>
  <span class="work-type-checkboxes__label">Тип работ<% if (!workTypeRequired) { %> <span class="muted">(необязательно)</span><% } %></span>
  <input type="hidden" name="work_type" value="<%= selected.length ? selected.join(', ') : '' %>" />
  <div class="work-type-checkboxes__options">
    <% workTypes.forEach(function(t) { %>
      <label class="work-type-checkboxes__item">
        <input type="checkbox" data-work-type="<%= t %>" <%= selected.includes(t) ? 'checked' : '' %> />
        <%= t %>
      </label>
    <% }) %>
  </div>
</div>
