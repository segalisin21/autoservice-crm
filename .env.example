# Локальный запуск (SQLite)
PORT=3000
# Dev/test only — in production SESSION_SECRET must be >= 32 chars (openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Файл БД (по умолчанию data/dev.sqlite3)
# SQLITE_PATH=./data/dev.sqlite3

# Продакшен (Postgres)
# DATABASE_URL=postgresql://user:pass@localhost:5432/autoservice_crm
# PGSSLMODE=disable
# NODE_ENV=production
